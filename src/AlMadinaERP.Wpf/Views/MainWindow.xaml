<Window x:Class="AlMadinaERP.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AlMadinaERP.Wpf.ViewModels"
        xmlns:views="clr-namespace:AlMadinaERP.Wpf.Views"
        Title="AL MADINA BUILDING MATERIAL - ERP" 
        Height="850" Width="1360"
        MinWidth="1150" MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        x:Name="MainWin">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VendorsViewModel}">
            <views:VendorsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChartOfInventoryViewModel}">
            <views:ChartOfInventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReceiptsPaymentsViewModel}">
            <views:ReceiptsPaymentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BanksViewModel}">
            <views:BanksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalaryViewModel}">
            <views:SalaryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/> <!-- Top Maroon Header Bar (Hidden) -->
            <RowDefinition Height="*"/>  <!-- Main Content + Sidebar -->
            <RowDefinition Height="28"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP MAROON HEADER BAR (HIDDEN AS REQUESTED) -->
        <Border Grid.Row="0" Visibility="Collapsed" Background="#7A0C0C" Padding="16,0" MouseDown="HeaderBar_MouseDown">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Header Title -->
                <TextBlock Grid.Column="0" Text="AL MADINA BUILDING MATERIAL" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>

                <!-- Right Header Actions, User Profile & Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" Foreground="#F8FAFC" FontSize="14" Margin="8,0" Cursor="Hand" VerticalAlignment="Center"/>
                    <TextBlock Text="🌙" Foreground="#F8FAFC" FontSize="14" Margin="8,0" Cursor="Hand" VerticalAlignment="Center"/>
                    <TextBlock Text="🔄" Foreground="#F8FAFC" FontSize="14" Margin="8,0" Cursor="Hand" VerticalAlignment="Center"/>
                    <TextBlock Text="⣿" Foreground="#F8FAFC" FontSize="14" Margin="8,0" Cursor="Hand" VerticalAlignment="Center"/>
                    <TextBlock Text="❓" Foreground="#F8FAFC" FontSize="14" Margin="8,0" Cursor="Hand" VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="20" Fill="#A52A2A" Margin="10,0"/>

                    <StackPanel Margin="6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="AL MADINA BUILDING MATERIAL - ADMIN" Foreground="#FDE047" FontSize="9" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <Button Content="↳ LOGOUT" Command="{Binding LogoutCommand}" CommandParameter="{Binding ElementName=MainWin}" Background="#991B1B" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Padding="8,4" Margin="6,0,10,0" Cursor="Hand"/>

                    <Rectangle Width="1" Height="20" Fill="#A52A2A" Margin="4,0,10,0"/>

                    <!-- Standard Window Controls (Minimize, Maximize/Restore, Close) -->
                    <Button Click="MinimizeWindow_Click" Content="—" Background="Transparent" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Width="28" Height="28" Padding="0" Margin="2,0" Cursor="Hand" ToolTip="Minimize"/>
                    <Button Click="MaximizeWindow_Click" Content="❐" Background="Transparent" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Width="28" Height="28" Padding="0" Margin="2,0" Cursor="Hand" ToolTip="Maximize / Restore"/>
                    <Button Click="CloseWindow_Click" Content="✕" Background="#DC2626" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Width="28" Height="28" Padding="0" Margin="2,0" Cursor="Hand" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY: LEFT SIDEBAR + ACTIVE VIEW -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT EXPANDABLE TREE SIDEBAR MENU -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Sidebar Header Logo -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" Padding="12,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Resources/almadina_logo.jpeg" Height="34" Width="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="AL MADINA" Foreground="#0F172A" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Building Construction Material" Foreground="#64748B" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bottom User Profile Footer -->
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser}" Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="ADMIN" Foreground="#059669" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <Button Command="{Binding LogoutCommand}" CommandParameter="{Binding ElementName=MainWin}" Content="🚪 Logout" Background="Transparent" Foreground="#DC2626" FontSize="11" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Full Smooth-Scroll Navigation Tree Menu (EXACT ORDER REQUESTED) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                        <StackPanel Margin="6,8">
                            <!-- 1. Dashboard -->
                            <Button Style="{DynamicResource NavButton}" Command="{Binding NavigateTabCommand}" CommandParameter="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊 " FontSize="13"/>
                                    <TextBlock Text="Dashboard" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Settings -->
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙️ " FontSize="13"/>
                                        <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Button Content="Account Settings" Command="{Binding NavigateTabCommand}" CommandParameter="Settings" Style="{DynamicResource SubMenuButton}"/>
                                </StackPanel>
                            </Expander>

                            <!-- 3. Maintain -->
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💼 " FontSize="13"/>
                                        <TextBlock Text="Maintain" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Button Content="Customers" Command="{Binding NavigateTabCommand}" CommandParameter="Customers" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Vendors" Command="{Binding NavigateTabCommand}" CommandParameter="Vendors" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Expenses" Command="{Binding NavigateTabCommand}" CommandParameter="Expense" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Banks" Command="{Binding NavigateTabCommand}" CommandParameter="Banks" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Items / Products" Command="{Binding NavigateTabCommand}" CommandParameter="Inventory" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Chart of Inventory" Command="{Binding NavigateTabCommand}" CommandParameter="ChartOfInventory" Style="{DynamicResource SubMenuButton}"/>
                                </StackPanel>
                            </Expander>

                            <!-- 4. Purchases -->
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦 " FontSize="13"/>
                                        <TextBlock Text="Purchases" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Button Content="Purchase Invoice" Command="{Binding NavigateTabCommand}" CommandParameter="PurchaseInvoice" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Purchase Return" Command="{Binding NavigateTabCommand}" CommandParameter="PurchaseReturn" Style="{DynamicResource SubMenuButton}"/>
                                </StackPanel>
                            </Expander>

                            <!-- 5. Sales -->
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛒 " FontSize="13"/>
                                        <TextBlock Text="Sales" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Button Content="Sale Invoice" Command="{Binding NavigateTabCommand}" CommandParameter="SaleInvoice" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Sale Return" Command="{Binding NavigateTabCommand}" CommandParameter="SaleReturn" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="POS Counter Sale" Command="{Binding NavigateTabCommand}" CommandParameter="POSCounterSale" Style="{DynamicResource SubMenuButton}"/>
                                </StackPanel>
                            </Expander>


                            <!-- 7. Receipts -->
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📥 " FontSize="13"/>
                                        <TextBlock Text="Receipts" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Button Content="Cash Receipt" Command="{Binding NavigateTabCommand}" CommandParameter="Cash Receipt" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Bank Receipt" Command="{Binding NavigateTabCommand}" CommandParameter="Bank Receipt" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Other Income" Command="{Binding NavigateTabCommand}" CommandParameter="Other Income" Style="{DynamicResource SubMenuButton}"/>
                                </StackPanel>
                            </Expander>

                            <!-- 8. Payments -->
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📤 " FontSize="13"/>
                                        <TextBlock Text="Payments" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Button Content="Cash Payment" Command="{Binding NavigateTabCommand}" CommandParameter="Cash Payment" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Bank Payment" Command="{Binding NavigateTabCommand}" CommandParameter="Bank Payment" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Journal" Command="{Binding NavigateTabCommand}" CommandParameter="Journal Entry" Style="{DynamicResource SubMenuButton}"/>
                                </StackPanel>
                            </Expander>

                            <!-- 9. Salary -->
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💵 " FontSize="13"/>
                                        <TextBlock Text="Salary" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Button Content="Salary Staff" Command="{Binding NavigateTabCommand}" CommandParameter="Salary Staff" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Advance" Command="{Binding NavigateTabCommand}" CommandParameter="Salary Advance" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Salary Report" Command="{Binding NavigateTabCommand}" CommandParameter="Salary Staff Report" Style="{DynamicResource SubMenuButton}"/>
                                </StackPanel>
                            </Expander>

                            <!-- 10. Reports -->
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📈 " FontSize="13"/>
                                        <TextBlock Text="Reports" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Main Reports" Foreground="#06B6D4" FontSize="10" FontWeight="Bold" Margin="24,6,0,2"/>
                                    <Button Content="Journal Report" Command="{Binding NavigateTabCommand}" CommandParameter="Journal Report" Style="{DynamicResource SubMenuButton}"/>

                                    <TextBlock Text="Purchase Reports" Foreground="#06B6D4" FontSize="10" FontWeight="Bold" Margin="24,6,0,2"/>
                                    <Button Content="Purchase Summary" Command="{Binding NavigateTabCommand}" CommandParameter="Purchase Summary" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Vendor Balances" Command="{Binding NavigateTabCommand}" CommandParameter="Vendor Balances" Style="{DynamicResource SubMenuButton}"/>

                                    <TextBlock Text="Sale Reports" Foreground="#06B6D4" FontSize="10" FontWeight="Bold" Margin="24,6,0,2"/>
                                    <Button Content="POS Sales" Command="{Binding NavigateTabCommand}" CommandParameter="POS Sales" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Customer Balances" Command="{Binding NavigateTabCommand}" CommandParameter="Customer Balances" Style="{DynamicResource SubMenuButton}"/>

                                    <TextBlock Text="Inventory Reports" Foreground="#06B6D4" FontSize="10" FontWeight="Bold" Margin="24,6,0,2"/>
                                    <Button Content="Inventory Ledger" Command="{Binding NavigateTabCommand}" CommandParameter="Inventory Ledger" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Inventory Balances" Command="{Binding NavigateTabCommand}" CommandParameter="Inventory Balances" Style="{DynamicResource SubMenuButton}"/>
                                    <Button Content="Low Stock Alert" Command="{Binding NavigateTabCommand}" CommandParameter="Low Stock Alert" Style="{DynamicResource SubMenuButton}"/>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ACTIVE VIEW CONTENT -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#0A1120" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="SQLite WAL Mode Active | Offline Production Ready" Foreground="#06B6D4" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
