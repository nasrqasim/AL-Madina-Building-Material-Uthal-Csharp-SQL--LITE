                                                    <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="#0F172A" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Code}" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,4"/>
                                                    <TextBlock Text="{Binding SalePrice, StringFormat='Rs. {0:N0}'}" Foreground="#DC2626" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- RIGHT CART & PAY PANEL (SCREENSHOT 4 MATCH) -->
