                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="DISCOUNT (-)" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding NewInvoice.AdditionalDiscount, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Padding="6,2" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Background="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Border BorderBrush="#334155" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>
                                
                                <Grid Margin="0,4">
                                    <TextBlock Text="NET TOTAL" Foreground="#FACC15" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NewInvoice.TotalAmount, StringFormat='{}{0:N2}'}" Foreground="#FACC15" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="AMOUNT RECEIVED" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
