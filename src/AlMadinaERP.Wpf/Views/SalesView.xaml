                        <Button Content="📊 Export Excel" Visibility="Collapsed" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold"/>
                        <Button Command="{Binding OpenCreateInvoiceCommand}" Content="+ New Invoice" Background="#7A0C0C" Foreground="#FFFFFF" Padding="14,6" Margin="3" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="#FEE2E2" CornerRadius="20" Width="40" Height="40">
                                <TextBlock Text="📄" Foreground="#DC2626" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL INVOICES" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalInvoicesCount}" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="20" Width="40" Height="40">
                                <TextBlock Text="⏱️" Foreground="#16A34A" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="FULLY PAID" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding FullyPaidCount}" Foreground="#16A34A" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="20" Width="40" Height="40">
                                <TextBlock Text="💳" Foreground="#2563EB" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="POSTED" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding PostedCount}" Foreground="#2563EB" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="6" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="#FEF3C7" CornerRadius="20" Width="40" Height="40">
                                <TextBlock Text="⏱️" Foreground="#D97706" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DRAFTS" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DraftsCount}" Foreground="#D97706" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <!-- FILTER BAR -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" FontSize="11" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,0"
                                         ToolTip="Search by invoice number or customer name"/>
                                <DatePicker Grid.Column="2" SelectedDate="{Binding FromDate, Mode=TwoWay}" Height="30" FontSize="11" VerticalAlignment="Center" ToolTip="From Date"/>
                                <DatePicker Grid.Column="4" SelectedDate="{Binding ToDate, Mode=TwoWay}" Height="30" FontSize="11" VerticalAlignment="Center" ToolTip="To Date"/>
                                <ComboBox Grid.Column="6" SelectedValue="{Binding StatusFilter, Mode=TwoWay}" SelectedValuePath="Tag" Height="30" FontSize="11" VerticalAlignment="Center">
                                    <ComboBoxItem Content="All" Tag="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Posted" Tag="Posted"/>
                                    <ComboBoxItem Content="Draft" Tag="Draft"/>
                                    <ComboBoxItem Content="Paid" Tag="Paid"/>
                                </ComboBox>
                                <StackPanel Grid.Column="8" Orientation="Horizontal">
                                    <Button Command="{Binding SetTodayFilterCommand}" Content="Today" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" Padding="8,4" Margin="2,0" FontSize="10" FontWeight="SemiBold" Height="30" Cursor="Hand"/>
                                    <Button Command="{Binding SetThisMonthFilterCommand}" Content="This Month" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" Padding="8,4" Margin="2,0" FontSize="10" FontWeight="SemiBold" Height="30" Cursor="Hand"/>
                                    <Button Command="{Binding ClearDateFilterCommand}" Content="✕ Clear" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="8,4" Margin="2,0" FontSize="10" FontWeight="SemiBold" Height="30" Cursor="Hand"/>
                                    <Button Command="{Binding OpenCreateInvoiceCommand}" Content="+ New Invoice" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,4" Margin="8,0,0,0" FontSize="10" Height="30" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="360" RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNumber}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" Width="110"/>
                                <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat='PKR {0:N0}'}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="PAID" Binding="{Binding PaidAmount, StringFormat='PKR {0:N0}'}" Width="110"/>
                                <DataGridTemplateColumn Header="STATUS" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ACTIONS" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding DataContext.ViewInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="👁️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" ToolTip="View Details"/>
                                                <Button Command="{Binding DataContext.PrintA4Command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="🖨️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#059669" BorderThickness="0" Cursor="Hand" ToolTip="Print Invoice"/>
                                                <Button Command="{Binding DataContext.EditInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="✏️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#D97706" BorderThickness="0" Cursor="Hand" ToolTip="Edit Invoice"/>
                                                <Button Command="{Binding DataContext.DeleteInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="🗑️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" ToolTip="Delete Invoice"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- VIEW INVOICE DETAILS MODAL (IMAGE 2 MATCH) -->
        <Grid Visibility="{Binding IsViewInvoiceModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#80000000">
            <Border Background="#F8FAFC" Width="850" MaxHeight="680" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedViewInvoice}">
                        <!-- MODAL HEADER -->
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="Invoice Details" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Command="{Binding DataContext.CloseViewInvoiceModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="✖" Background="Transparent" Foreground="#64748B" FontSize="16" FontWeight="Bold" BorderThickness="0" DockPanel.Dock="Right" Cursor="Hand"/>
                        </DockPanel>

                        <!-- 4 TOP CARDS (IMAGE 2 MATCH) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="TOTAL AMOUNT" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='PKR {0:N2}'}" Foreground="#0F172A" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="BALANCE DUE" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding OutstandingAmount, StringFormat='PKR {0:N2}'}" Foreground="#16A34A" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="INVOICE DATE" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Date, StringFormat='dd/MM/yyyy'}" Foreground="#0F172A" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="DUE DATE" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Date, StringFormat='dd/MM/yyyy'}" Foreground="#0F172A" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- BILLING INFORMATION CARD (IMAGE 2 MATCH) -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Border BorderBrush="#7A0C0C" BorderThickness="3,0,0,0" Padding="8,0,0,0" Margin="0,0,0,14">
                                    <TextBlock Text="BILLING INFORMATION" Foreground="#475569" FontSize="11" FontWeight="Bold"/>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CUSTOMER" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DisplayCustomerName}" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="TERMS" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SaleCategory, FallbackValue='Cash'}" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="VEHICLE NO" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding VehicleNo, FallbackValue='-'}" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="DRIVER / KMS" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DriverKm, FallbackValue='0/0/0'}" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LOCATION" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Location, FallbackValue='Main Warehouse'}" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="SALES PERSON" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Salesman, FallbackValue='Admin'}" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="OIL GAUGE LIMIT" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="0" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="REMARKS" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Remarks, FallbackValue='-'}" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- INVOICE ITEMS CARD (IMAGE 2 MATCH) -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="INVOICE ITEMS" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" MinHeight="150">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding ItemId}" Width="40"/>
                                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding ItemName}" Width="*"/>
                                        <DataGridTemplateColumn Header="STATUS" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Received ✓"/>
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReceived}" Value="False">
                                                                        <Setter Property="Text" Value="Not Received ✗"/>
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="CARTONS / QTY" Binding="{Binding Quantity}" Width="110"/>
                                        <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat='{}{0:N2}'}" Width="100"/>
                                        <DataGridTextColumn Header="GROSS AMT" Binding="{Binding TotalPrice, StringFormat='{}{0:N2}'}" Width="110"/>
                                        <DataGridTextColumn Header="DISC %" Binding="{Binding DiscountPercent, StringFormat='{}{0:N0}%'}" Width="80"/>
                                        <DataGridTextColumn Header="NET AMOUNT" Binding="{Binding TotalPrice, StringFormat='{}{0:N2}'}" Width="120" FontWeight="Bold"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel HorizontalAlignment="Right" Margin="0,16,0,0" Width="260">
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="SUBTOTAL (GROSS)" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Subtotal, StringFormat='{}{0:N2}'}" Foreground="#0F172A" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="INVOICE TOTAL (PKR)" Foreground="#7A0C0C" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2}'}" Foreground="#7A0C0C" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ACTION BUTTONS -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding DataContext.PrintA4Command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path=SelectedViewInvoice, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="📄 Print A4 Invoice" Background="#7A0C0C" Foreground="#FFFFFF" Padding="14,8" Margin="0,0,8,0" FontWeight="Bold" Cursor="Hand"/>
                            <Button Command="{Binding DataContext.PrintThermalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path=SelectedViewInvoice, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="🧾 Print Thermal Receipt" Background="#0F172A" Foreground="#FFFFFF" Padding="14,8" Margin="0,0,8,0" FontWeight="Bold" Cursor="Hand"/>
                            <Button Command="{Binding DataContext.CloseViewInvoiceModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Close" Background="#E2E8F0" Foreground="#334155" Padding="14,8" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
