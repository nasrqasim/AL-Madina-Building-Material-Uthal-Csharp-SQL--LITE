<UserControl x:Class="AlMadinaERP.Wpf.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar & Quick Actions -->
            <RowDefinition Height="Auto"/> <!-- 4 Stat Cards -->
            <RowDefinition Height="*"/>    <!-- Categories Tree + Inventory Grid -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: PAGE TITLE & ACTIONS (SCREENSHOT 10 MATCH) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Chart of Inventory" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Manage product categories and individual items" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Add New Item" Command="{Binding OpenAddItemModalCommand}" Background="#7A0C0C" Foreground="#FFFFFF" Padding="14,7" Margin="3" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="🖨️ Print List" Command="{Binding PrintItemListCommand}" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,7" Margin="3" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- 4 TOP STAT CARDS (SCREENSHOT 10 MATCH) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Items -->
            <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Items" Foreground="#1E40AF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalItemsCount}" Foreground="#1D4ED8" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"/>
                </Grid>
            </Border>

            <!-- Card 2: Low Stock -->
            <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,8,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Low Stock" Foreground="#B45309" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LowStockCount}" Foreground="#D97706" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="⚠️" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"/>
                </Grid>
            </Border>

            <!-- Card 3: Total Value -->
            <Border Grid.Column="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,8,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Value" Foreground="#047857" FontSize="11" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="PKR " Foreground="#059669" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding TotalValue, StringFormat='{}{0:N0}'}" Foreground="#059669" FontSize="22" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="📄" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"/>
                </Grid>
            </Border>

            <!-- Card 4: Avg Purchase Rate -->
            <Border Grid.Column="3" Background="#FDF2F8" BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,0,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Avg Purchase Rate" Foreground="#BE185D" FontSize="11" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Rs." Foreground="#DB2777" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding AvgPurchaseRate, StringFormat='{}{0:N0}'}" Foreground="#DB2777" FontSize="22" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="📚" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"/>
                </Grid>
            </Border>
        </Grid>

        <!-- MAIN SECTION: CATEGORIES TREE + INVENTORY DATAGRID -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT CATEGORIES TREE -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- CATEGORIES HEADER WITH WORKING + BUTTON -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="CATEGORIES" Foreground="#64748B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Command="{Binding OpenAddCategoryModalCommand}" Content="+" Background="#7A0C0C" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Width="22" Height="22" Padding="0" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Add Category"/>
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                            <Grid>
                                <TextBlock Text="All Categories" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="›" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁 " FontSize="12"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#991B1B" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="›" Foreground="#991B1B" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT INVENTORY TABLE (SCREENSHOT 10 MATCH) -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16">
                <DockPanel>
                    <!-- Search Bar & Filters Header -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Breadcrumb & Search Box -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="INVENTORY  ›  " Foreground="#94A3B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="ALL ITEMS" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="300" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍 " Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Show Items & View Mode -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Show: " Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Width="110" Height="28" SelectedIndex="0" Margin="0,0,12,0" FontSize="11">
                                <ComboBoxItem Content="25 per page"/>
                                <ComboBoxItem Content="50 per page"/>
                                <ComboBoxItem Content="100 per page"/>
                            </ComboBox>
                            <Button Content="☰ List View" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,4" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Items DataGrid Table with Full Visibility & Horizontal Scroll -->
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All" HorizontalGridLinesBrush="#CBD5E1" VerticalGridLinesBrush="#CBD5E1" RowHeight="38" MinWidth="1400" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ITEM CODE" Binding="{Binding Code}" Width="130" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding Name}" Width="260" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="UNIT" Binding="{Binding BaseUnit}" Width="90"/>
                                    <DataGridTextColumn Header="PURCHASE PRICE" Binding="{Binding PurchasePrice, StringFormat='PKR {0:N0}'}" Width="130"/>
                                    <DataGridTextColumn Header="SALE PRICE" Binding="{Binding SalePrice, StringFormat='PKR {0:N0}'}" Width="120" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="OPENING STOCK" Binding="{Binding OpeningStock, StringFormat='{}{0:N0}'}" Width="120"/>
                                    <DataGridTextColumn Header="QTY IN" Binding="{Binding StockIn, StringFormat='{}{0:N0}'}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#059669"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="QTY OUT" Binding="{Binding StockOut, StringFormat='{}{0:N0}'}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="CURRENT STOCK" Binding="{Binding CurrentStock, StringFormat='{}{0:N0}'}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="RESERVED" Binding="{Binding ReservedStock, StringFormat='{}{0:N0}'}" Width="100"/>
                                    <DataGridTextColumn Header="AVAILABLE" Binding="{Binding AvailableStock, StringFormat='{}{0:N0}'}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#047857"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="WAREHOUSE" Binding="{Binding Warehouse}" Width="130"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" FontWeight="Bold"/>
                                    <DataGridTemplateColumn Header="ACTIONS" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="✏️ Edit" Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" Padding="6,2" Margin="0,0,4,0" FontSize="10" FontWeight="Bold" Cursor="Hand"/>
                                                    <Button Content="🗑️" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECDD3" BorderThickness="1" Padding="4,2" FontSize="10" FontWeight="Bold" Cursor="Hand"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                        
                        <!-- EMPTY STATE BANNER WHEN NO ITEMS FOUND -->
                        <Border Visibility="{Binding HasNoItemsFound, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="No item name found" FontSize="16" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Try searching for another keyword or category." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ADD PRODUCT MASTER MODAL DIALOG (SCREENSHOT 11 MATCH) -->
        <Grid Visibility="{Binding IsAddItemModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.RowSpan="3" Background="#80000000">
            <Border Background="#FFFFFF" CornerRadius="12" Width="760" MaxHeight="780" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Grid DockPanel.Dock="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Modal Header -->
                        <RowDefinition Height="*"/>    <!-- Modal Form ScrollViewer -->
                        <RowDefinition Height="Auto"/> <!-- Modal Footer -->
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <TextBlock Text="Add Product Master" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <Button Command="{Binding CloseAddItemModalCommand}" Content="✕" Background="Transparent" Foreground="#64748B" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Modal Form Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>

                            <!-- SECTION 1: BASIC INFO -->
                            <TextBlock Text="BASIC INFO" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="ITEM CODE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Code}" Background="#F8FAFC"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="ITEM NAME" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Name}"/>
                                </StackPanel>

                                <!-- EDITABLE SELLING UNIT COMBOBOX -->
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="SELLING UNIT" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <ComboBox Text="{Binding SelectedItem.SellingUnit, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="34" Margin="0,4,0,10">
                                        <ComboBoxItem Content="Per Piece"/>
                                        <ComboBoxItem Content="Bag"/>
                                        <ComboBoxItem Content="Kg"/>
                                        <ComboBoxItem Content="Ton"/>
                                        <ComboBoxItem Content="Meter"/>
                                        <ComboBoxItem Content="Feet"/>
                                        <ComboBoxItem Content="Box"/>
                                        <ComboBoxItem Content="Liter"/>
                                        <ComboBoxItem Content="Cft"/>
                                        <ComboBoxItem Content="Sqft"/>
                                        <ComboBoxItem Content="Bundle"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- SECTION 2: UNIT CONFIGURATION & CATEGORY -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                            <TextBlock Text="UNIT CONFIGURATION &amp; CATEGORY" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="BASE UNIT" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <ComboBox Text="{Binding SelectedItem.BaseUnit, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="34" Margin="0,4,0,10">
                                        <ComboBoxItem Content="Per Piece"/>
                                        <ComboBoxItem Content="Bag"/>
                                        <ComboBoxItem Content="Kg"/>
                                        <ComboBoxItem Content="Ton"/>
                                        <ComboBoxItem Content="Meter"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="PURCHASE UNIT" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <ComboBox Text="{Binding SelectedItem.PurchaseUnitName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="34" Margin="0,4,0,10">
                                        <ComboBoxItem Content="Per Piece"/>
                                        <ComboBoxItem Content="Bag"/>
                                        <ComboBoxItem Content="Kg"/>
                                        <ComboBoxItem Content="Ton"/>
                                        <ComboBoxItem Content="Meter"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="SALE UNIT" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <ComboBox Text="{Binding SelectedItem.SaleUnitName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="34" Margin="0,4,0,10">
                                        <ComboBoxItem Content="Per Piece"/>
                                        <ComboBoxItem Content="Bag"/>
                                        <ComboBoxItem Content="Kg"/>
                                        <ComboBoxItem Content="Ton"/>
                                        <ComboBoxItem Content="Meter"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                    <TextBlock Text="CONVERSION FACTOR" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.ConversionFactor}"/>
                                </StackPanel>
                            </Grid>

                            <!-- EDITABLE CATEGORY INPUT FIELD ON FORM -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="CATEGORY (SELECT OR TYPE NEW CATEGORY)" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" Text="{Binding SelectedItem.CategoryName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="34" Margin="0,4,0,10"/>
                                </StackPanel>
                            </Grid>

                            <!-- SECTION 3: SPECIFICATIONS -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                            <TextBlock Text="SPECIFICATIONS" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="BRAND" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Brand}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="MODEL" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Model}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="COLOR" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Color}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="4,0,4,0">
                                    <TextBlock Text="SIZE / DIMENSIONS" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Dimensions}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="4,0,4,0">
                                    <TextBlock Text="THICKNESS" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Thickness}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="5" Margin="4,0,0,0">
                                    <TextBlock Text="GRADE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Grade}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="LENGTH" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Length}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="WIDTH" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Width}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="WEIGHT (KG)" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.WeightKg}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="4,0,4,0">
                                    <TextBlock Text="DESCRIPTION" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Description}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="4,0,0,0">
                                    <TextBlock Text="QUALITY" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Quality}"/>
                                </StackPanel>
                            </Grid>

                            <!-- SECTION 4: PRICING & TAXES -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                            <TextBlock Text="PRICING &amp; TAXES" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="PURCHASE PRICE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.PurchasePrice}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="RETAIL SALE PRICE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.SalePrice}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="WHOLESALE PRICE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.WholesalePrice}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                    <TextBlock Text="DEALER PRICE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.DealerPrice}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="CONTRACT PRICE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.ContractPrice}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="LENGTH (FEET)" Foreground="#1E3A8A" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.LengthFeet}" FontWeight="Bold" Foreground="#1E3A8A" ToolTip="Default length in feet for TEAR / GIRDER items"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="RATE PER FOOT" Foreground="#1E3A8A" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.RatePerFoot}" FontWeight="Bold" Foreground="#1E3A8A" ToolTip="Default PKR rate per foot for TEAR / GIRDER items"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="4,0,4,0">
                                    <TextBlock Text="SALES TAX (%)" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.SalesTaxPercent}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="4,0,4,0">
                                    <TextBlock Text="DEFAULT DISCOUNT (%)" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.DefaultDiscountPercent}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="5" Margin="4,0,0,0">
                                    <TextBlock Text="STATUS" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <ComboBox SelectedValue="{Binding SelectedItem.Status}" SelectedValuePath="Content" Height="34" Margin="0,4,0,10">
                                        <ComboBoxItem Content="Active"/>
                                        <ComboBoxItem Content="Inactive"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- SECTION 5: INVENTORY & LOCATIONS -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                            <TextBlock Text="INVENTORY &amp; LOCATIONS" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="OPENING STOCK" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.OpeningStock}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="MIN STOCK (REORDER)" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.LowStockAlert}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="MAX STOCK LIMIT" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.MaxStockLimit}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                    <TextBlock Text="WAREHOUSE / GODOWN" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Warehouse}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="LOCATION / AISLE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.LocationAisle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="RACK NUMBER" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.RackNumber}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="REMARKS / NOTES" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedItem.Notes}"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer Buttons -->
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CloseAddItemModalCommand}" Content="Cancel" Background="Transparent" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0" Cursor="Hand"/>
                            <Button Command="{Binding SaveItemCommand}" Content="💾 Save Product" Background="#7A0C0C" Foreground="#FFFFFF" Padding="18,8" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <!-- ADD CATEGORY MODAL DIALOG -->
        <Grid Visibility="{Binding IsAddCategoryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.RowSpan="3" Background="#80000000">
            <Border Background="#FFFFFF" CornerRadius="10" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Add New Category" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <Button Command="{Binding CloseAddCategoryModalCommand}" Content="✕" Background="Transparent" Foreground="#64748B" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <TextBlock Text="CATEGORY NAME" Foreground="#475569" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseAddCategoryModalCommand}" Content="Cancel" Background="Transparent" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Command="{Binding SaveCategoryCommand}" Content="Save Category" Background="#7A0C0C" Foreground="#FFFFFF" Padding="14,6" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
