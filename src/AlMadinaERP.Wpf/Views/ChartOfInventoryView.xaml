<UserControl x:Class="AlMadinaERP.Wpf.Views.ChartOfInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar & Search -->
            <RowDefinition Height="*"/>    <!-- 4 Columns Horizontal Grid -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: PAGE TITLE & SEARCH (SCREENSHOT 12 MATCH) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Page Title -->
            <TextBlock Grid.Column="0" Text="Chart of Inventory" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,24,0"/>

            <!-- Search Items input & Find button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="240" Padding="8,4" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍 " Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Button Content="🔍 Find" Command="{Binding LoadChartCommand}" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Right Buttons: Chart & Price List -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📊 Chart" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                <Button Content="🏷️ Price List" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- 3-COLUMN HORIZONTAL GRID -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Column 1: Main Categories -->
                <ColumnDefinition Width="320"/> <!-- Column 2: Inventory Items -->
                <ColumnDefinition Width="*"/>   <!-- Column 3: Live Item Details Panel -->
            </Grid.ColumnDefinitions>

            <!-- COLUMN 1: MAIN CATEGORIES -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Main Categories" Foreground="#475569" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Command="{Binding AddNewCategoryCommand}" Content="+ Add" Background="#F1F5F9" Foreground="#7A0C0C" BorderBrush="#CBD5E1" BorderThickness="1" Padding="6,2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#334155"/>
                </DockPanel>
            </Border>

            <!-- COLUMN 2: INVENTORY ITEMS LIST -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Inventory Items" Foreground="#475569" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Command="{Binding AddNewItemCommand}" Content="+ Add Item" Background="#7A0C0C" Foreground="#FFFFFF" Padding="6,2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎯 " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#0F172A" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Code}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- COLUMN 3: LIVE ITEM DETAILS PANEL -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Panel Header & Action Buttons -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Item Details" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding AddNewItemCommand}" Content="➕ Add New" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,4" Margin="0,0,6,0" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                <Button Command="{Binding SaveSelectedItemCommand}" Content="💾 Save Item" Background="#7A0C0C" Foreground="#FFFFFF" Padding="12,4" Margin="0,0,6,0" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                <Button Command="{Binding DeleteSelectedItemCommand}" Content="🗑️ Delete" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECDD3" BorderThickness="1" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- Form Row 1: Item Code & Item Name -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Item Code" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedItem.Code}" Background="#F8FAFC"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Item Name" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedItem.Name}" Background="#F8FAFC"/>
                            </StackPanel>
                        </Grid>

                        <!-- Form Row 2: Purchase Price / Ctn & Wholesale Price / Ctn -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Purchase Price / Ctn" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedItem.PurchasePrice, StringFormat='{}{0:0}'}" Background="#F8FAFC"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Wholesale Price / Ctn" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedItem.WholesalePrice, StringFormat='{}{0:0}'}" Background="#F8FAFC"/>
                            </StackPanel>
                        </Grid>

                        <!-- Form Row 3: Retail Price / Ctn & Re-order Quantity -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Retail Price / Ctn" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedItem.SalePrice, StringFormat='{}{0:0}'}" Background="#F8FAFC"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Re-order Quantity" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedItem.LowStockAlert, StringFormat='{}{0:0}'}" Background="#F8FAFC"/>
                            </StackPanel>
                        </Grid>

                        <!-- Form Row 4: Unit & Weight (KG/Gram) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Unit" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedItem.SellingUnit}" Background="#F8FAFC"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Weight (KG/Gram)" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedItem.WeightKg}" Background="#F8FAFC"/>
                            </StackPanel>
                        </Grid>

                        <!-- Form Row 5: Size -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Size" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                            <TextBox Text="{Binding SelectedItem.Dimensions}" Background="#F8FAFC" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
