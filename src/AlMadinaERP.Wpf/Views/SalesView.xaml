                                                <DataTrigger Binding="{Binding IsReturnMode}" Value="True">
                                                    <Setter Property="Text" Value="REFUND SUMMARY"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                
                                <Grid Margin="0,4">
                                    <TextBlock Text="GROSS TOTAL" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
