                                <TextBlock Text="{Binding Category}" Foreground="#0F172A" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="AMOUNT" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Amount, StringFormat='PKR {0:N2}'}" Foreground="#DC2626" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="PAID FROM" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="{Binding PaidFrom, FallbackValue='Cash'}" Foreground="#0F172A" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                <TextBlock Text="STATUS" Foreground="#94A3B8" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Status, FallbackValue='Paid'}" Foreground="#15803D" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Command="{Binding CloseViewExpenseModalCommand}" Content="Close" Background="#7A0C0C" Foreground="#FFFFFF" Padding="20,8" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
