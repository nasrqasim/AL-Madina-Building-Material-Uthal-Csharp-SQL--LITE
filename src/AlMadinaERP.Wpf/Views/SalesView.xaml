                                        <DataTemplate>
                                            <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ACTIONS" Width="80">
