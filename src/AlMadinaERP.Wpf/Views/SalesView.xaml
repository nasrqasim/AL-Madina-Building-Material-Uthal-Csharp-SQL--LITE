                                <TextBlock Text="{Binding SelectedCustomer.Address, StringFormat='Address: {0}', FallbackValue='Address: Uthal'}" Foreground="#B45309" FontSize="11" Margin="0,2,0,0"/>
                                <Border BorderBrush="#FCD34D" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                                <Grid Margin="0,2">
                                    <TextBlock Text="LIMIT" Foreground="#92400E" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="PKR 0" Foreground="#92400E" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="OUTSTANDING" Foreground="#92400E" FontSize="10" FontWeight="Bold"/>
