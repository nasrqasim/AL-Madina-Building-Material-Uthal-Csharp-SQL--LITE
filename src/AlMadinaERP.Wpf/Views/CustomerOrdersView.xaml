<UserControl x:Class="AlMadinaERP.Wpf.Views.CustomerOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200" Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Customer Orders Management" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Manage customer advance orders, length-wise items (TEAR/GIRDER), and pending/completed status" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding PrintOrdersListCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="16,8" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖨️ Print Directory" FontWeight="Bold" Margin="0,0,6,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenNewOrderModalCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕ New Customer Order" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL ORDERS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalOrdersCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="#FEF3C7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="PENDING ORDERS" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                    <TextBlock Text="{Binding PendingOrdersCount}" FontSize="24" FontWeight="Bold" Foreground="#B45309" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="16" BorderBrush="#DCFCE7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="COMPLETED ORDERS" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                    <TextBlock Text="{Binding CompletedOrdersCount}" FontSize="24" FontWeight="Bold" Foreground="#166534" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0F2FE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL VALUE / REMAINING" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                    <TextBlock Text="{Binding TotalOrdersAmount, StringFormat='Rs. {0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding TotalRemainingAmount, StringFormat='Bal: Rs. {0:N0}'}" FontSize="11" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search & Filter Controls -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Tag="Search by Order #, Customer Name, Serial No, or Contact..." 
                         Height="38" Padding="10,0" VerticalContentAlignment="Center" FontSize="13"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <RadioButton Content="All Orders" IsChecked="{Binding SelectedStatusFilter, ConverterParameter=All, Mode=OneWay}" 
                                 Command="{Binding FilterByStatusCommand}" CommandParameter="All" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Pending" IsChecked="{Binding SelectedStatusFilter, ConverterParameter=Pending, Mode=OneWay}" 
                                 Command="{Binding FilterByStatusCommand}" CommandParameter="Pending" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Completed" IsChecked="{Binding SelectedStatusFilter, ConverterParameter=Completed, Mode=OneWay}" 
                                 Command="{Binding FilterByStatusCommand}" CommandParameter="Completed" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Orders DataGrid -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
            <DataGrid ItemsSource="{Binding FilteredOrders}" AutoGenerateColumns="False" CanUserAddRows="False" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" RowHeight="44" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SR #" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="ORDER #" Binding="{Binding OrderNumber}" Width="110" FontWeight="Bold"/>
                    <DataGridTextColumn Header="CUSTOMER NAME" Binding="{Binding CustomerName}" Width="180" FontWeight="Bold"/>
                    <DataGridTextColumn Header="CONTACT" Binding="{Binding ContactNumber}" Width="120"/>
                    <DataGridTextColumn Header="ORDER DATE" Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="RECEIVING DATE" Binding="{Binding ReceivingDate, StringFormat='dd/MM/yyyy'}" Width="110"/>
                    <DataGridTextColumn Header="TOTAL (PKR)" Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" Width="120" FontWeight="Bold" Foreground="#1E293B"/>
                    <DataGridTextColumn Header="PAID (PKR)" Binding="{Binding PaidAmount, StringFormat='Rs. {0:N2}'}" Width="110" Foreground="#16A34A"/>
                    <DataGridTextColumn Header="BALANCE (PKR)" Binding="{Binding RemainingAmount, StringFormat='Rs. {0:N2}'}" Width="120" FontWeight="Bold" Foreground="#DC2626"/>

                    <DataGridTemplateColumn Header="STATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleOrderStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource OutlineButtonStyle}" Padding="6,2" FontSize="11">
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ACTIONS" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.ViewOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="👁 View" Margin="0,0,6,0" Padding="8,4" FontSize="11"/>
                                    <Button Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="✏ Edit" Margin="0,0,6,0" Padding="8,4" FontSize="11"/>
                                    <Button Command="{Binding DataContext.PrintCustomerOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="🖨 Print" Margin="0,0,6,0" Padding="8,4" FontSize="11"/>
                                    <Button Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="🗑" Foreground="Red" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- New / Edit Order Modal Overlay -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsOrderModalOpen, Converter={StaticResource BoolToVis}}" Background="#80000000">
            <Border Background="White" CornerRadius="12" Width="920" MaxHeight="750" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding ModalTitle}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <Button Command="{Binding CloseOrderModalCommand}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Header Form Inputs -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CUSTOMER NAME *" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                    <ComboBox ItemsSource="{Binding MasterCustomers}" SelectedItem="{Binding FormSelectedCustomer}" DisplayMemberPath="Name" Text="{Binding FormCustomerName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="36" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CONTACT NUMBER" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                    <TextBox Text="{Binding FormContactNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="DELIVERY ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                    <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ORDER DATE" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                    <DatePicker SelectedDate="{Binding FormOrderDate}" Height="36" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RECEIVING DATE" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                    <DatePicker SelectedDate="{Binding FormReceivingDate}" Height="36" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                    <ComboBox SelectedValue="{Binding FormStatus}" SelectedValuePath="Content" Height="36" Margin="0,4,0,0">
                                        <ComboBoxItem Content="Pending"/>
                                        <ComboBoxItem Content="Completed"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Line Item Entry Section -->
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ADD ORDER ITEMS (TEAR / GIRDER LENGTH-BASED SUPPORT)" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LenCol"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SELECT ITEM *" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <ComboBox ItemsSource="{Binding MasterItems}" SelectedItem="{Binding SelectedMasterItem}" DisplayMemberPath="Name" IsEditable="True" Height="32" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="QTY *" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBox Text="{Binding NewItemQuantity, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Visibility="{Binding IsLengthInputVisible, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="LENGTH (FT) *" FontSize="10" FontWeight="Bold" Foreground="#D97706"/>
                                            <TextBox Text="{Binding NewItemLengthFeet, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="32" Margin="0,2,0,0" FontWeight="Bold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="UNIT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBox Text="{Binding NewItemUnit}" Height="32" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="8">
                                            <TextBlock Text="RATE (PKR) *" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBox Text="{Binding NewItemRate, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="10" Command="{Binding AddItemLineCommand}" Content="＋ Add" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="14,0" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Items DataGrid -->
                            <DataGrid ItemsSource="{Binding CurrentOrderItems}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" Height="180" Margin="0,0,0,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemNameSnapshot}" Width="2*"/>
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="*"/>
                                    <DataGridTextColumn Header="LENGTH (FT)" Binding="{Binding LengthFeet}" Width="*"/>
                                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="*"/>
                                    <DataGridTextColumn Header="RATE (PKR)" Binding="{Binding Rate, StringFormat='{}{0:N2}'}" Width="*"/>
                                    <DataGridTextColumn Header="TOTAL (PKR)" Binding="{Binding LineTotal, StringFormat='{}{0:N2}'}" Width="120" FontWeight="Bold"/>
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveItemLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="❌" Background="Transparent" BorderThickness="0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Payments & Totals Calculation Bar -->
                            <Border Background="#F1F5F9" Padding="14" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ORDER GRAND TOTAL" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                        <TextBlock Text="{Binding FormTotalAmount, StringFormat='Rs. {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="AMOUNT PAID (PKR)" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                        <TextBox Text="{Binding FormPaidAmount, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="14" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="REMAINING BALANCE" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                                        <TextBlock Text="{Binding FormRemainingAmount, StringFormat='Rs. {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Command="{Binding CloseOrderModalCommand}" Content="Cancel" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,12,0" Padding="16,8"/>
                        <Button Command="{Binding SaveOrderCommand}" Content="💾 Save Order" Style="{StaticResource PrimaryButtonStyle}" Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- View Order Details Modal Overlay -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsViewModalOpen, Converter={StaticResource BoolToVis}}" Background="#80000000">
            <Border Background="White" CornerRadius="12" Width="700" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding SelectedOrder.OrderNumber, StringFormat='Customer Order Details ({0})'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <Button Command="{Binding CloseViewModalCommand}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedOrder.CustomerName, StringFormat='Customer: {0}'}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedOrder.ContactNumber, StringFormat='Contact: {0}'}" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedOrder.Address, StringFormat='Address: {0}'}" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectedOrder.OrderDate, StringFormat='Order Date: {0:dd/MM/yyyy}'}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedOrder.ReceivingDate, StringFormat='Receiving: {0:dd/MM/yyyy}'}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedOrder.Status, StringFormat='Status: {0}'}" FontWeight="Bold" Foreground="#D97706"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid ItemsSource="{Binding SelectedOrder.Items}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" Height="180" Margin="0,0,0,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemNameSnapshot}" Width="2*"/>
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="*"/>
                                    <DataGridTextColumn Header="LENGTH (FT)" Binding="{Binding LengthFeet}" Width="*"/>
                                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="*"/>
                                    <DataGridTextColumn Header="RATE (PKR)" Binding="{Binding Rate, StringFormat='{}{0:N2}'}" Width="*"/>
                                    <DataGridTextColumn Header="TOTAL (PKR)" Binding="{Binding LineTotal, StringFormat='{}{0:N2}'}" Width="120" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SelectedOrder.TotalAmount, StringFormat='Grand Total: Rs. {0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding SelectedOrder.PaidAmount, StringFormat='Amount Paid: Rs. {0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#16A34A"/>
                                <TextBlock Text="{Binding SelectedOrder.RemainingAmount, StringFormat='Remaining Balance: Rs. {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Command="{Binding CloseViewModalCommand}" Content="Close" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
