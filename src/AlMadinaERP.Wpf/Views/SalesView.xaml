                                </Grid>

                                <Border Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                                    <Grid>
                                        <TextBlock Text="ADVANCE BALANCE" Foreground="#0369A1" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedCustomer.AdvanceAvailable, StringFormat='PKR {0:N2}', FallbackValue='0.00'}" Foreground="#0284C7" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- DARK SUMMARY BOX (IMAGE 4 MATCH) -->
                        <Border Background="#0F172A" CornerRadius="8" Padding="16">
