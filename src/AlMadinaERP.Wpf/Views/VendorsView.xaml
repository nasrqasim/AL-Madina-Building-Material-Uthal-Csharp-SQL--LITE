<UserControl x:Class="AlMadinaERP.Wpf.Views.VendorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid>
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- TOP BREADCRUMB & HEADER -->
                <Grid Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Vendors" Foreground="#0F172A" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Master Data / Vendors" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📊 Export Excel" Visibility="Collapsed" Background="#E2E8F0" Foreground="#1E293B" Padding="10,6" Margin="3"/>
                        <Button Content="🖨️ Print List" Command="{Binding PrintVendorsListCommand}" Background="#E2E8F0" Foreground="#1E293B" Padding="10,6" Margin="3" Cursor="Hand"/>
                        <Button Content="📥 Download Template" Background="#E2E8F0" Foreground="#1E293B" Padding="10,6" Margin="3"/>
                        <Button Content="📤 Import Excel" Background="#E2E8F0" Foreground="#1E293B" Padding="10,6" Margin="3"/>
                    </StackPanel>
                </Grid>

                <!-- 4 TOP SUMMARY CARDS (Screenshot 6 Match) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#F1F5F9" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="👤" Foreground="#475569" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Vendors" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalVendorsCount, FallbackValue=3}" Foreground="#0F172A" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Total Vendor Payables" Foreground="#BE123C" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalVendorPayables, StringFormat='Rs. {0:N0}', FallbackValue='Rs. 13,850'}" Foreground="#9F1239" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#DCFCE7" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="👤" Foreground="#16A34A" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Vendor Advances" Foreground="#15803D" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalVendorAdvances, StringFormat='Rs. {0:N0}', FallbackValue='Rs. 89,870'}" Foreground="#166534" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="6" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#D1FAE5" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="💳" Foreground="#059669" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Net Vendor Balance" Foreground="#047857" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding NetVendorBalance, StringFormat='Rs. {0:N0}', FallbackValue='Rs. 76,020'}" Foreground="#065F46" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- FILTER BAR -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <Grid>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="380" HorizontalAlignment="Left" Padding="10,6" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🖨️ PRINT" Command="{Binding PrintVendorsListCommand}" Background="#E2E8F0" Foreground="#1E293B" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="+ NEW VENDOR" Command="{Binding OpenAddVendorModalCommand}" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- VENDORS DATAGRID TABLE (Screenshot 6 Match) -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <DataGrid ItemsSource="{Binding Vendors}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="400" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="VENDOR" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="PAYABLE (WE OWE)" Binding="{Binding VendorOwes, StringFormat='Rs. {0:N0}'}" Width="180" Foreground="#DC2626"/>
                                <DataGridTextColumn Header="ADVANCE PAID" Binding="{Binding AdvanceAvailable, StringFormat='Rs. {0:N0}'}" Width="180" Foreground="#16A34A"/>
                                <DataGridTextColumn Header="NET BALANCE" Binding="{Binding NetBalance, StringFormat='Rs. {0:N0}'}" Width="150" FontWeight="Bold"/>
                                <DataGridTemplateColumn Header="STATUS" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding StatusText}" Foreground="#0F172A" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ACTIONS" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" Command="{Binding DataContext.EditVendorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="3,1" Margin="2" Background="Transparent" Foreground="#2563EB" Cursor="Hand" ToolTip="Edit Vendor"/>
                                                <Button Content="📕" Command="{Binding DataContext.LoadVendorLedgerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Padding="3,1" Margin="2" Background="Transparent" Foreground="#7A0C0C" Cursor="Hand" ToolTip="View Ledger"/>
                                                <Button Content="🗑️" Command="{Binding DataContext.DeleteVendorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Padding="3,1" Margin="2" Background="Transparent" Foreground="#DC2626" Cursor="Hand" ToolTip="Delete Vendor"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border DockPanel.Dock="Bottom" Background="#F1F5F9" Padding="16,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock Text="TOTAL PER PAGE:" Foreground="#0F172A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding TotalVendorPayables, StringFormat='Payables: Rs. {0:N0}'}" Foreground="#DC2626" FontSize="12" FontWeight="Bold" Margin="0,0,20,0"/>
                                    <TextBlock Text="{Binding TotalVendorAdvances, StringFormat='Advances: Rs. {0:N0}'}" Foreground="#16A34A" FontSize="12" FontWeight="Bold" Margin="0,0,20,0"/>
                                    <TextBlock Text="{Binding NetVendorBalance, StringFormat='Net: Rs. {0:N0}'}" Foreground="#059669" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ADD NEW VENDOR MODAL FORM (Screenshot 7 100% Match) -->
        <Grid Background="#80000000" Visibility="{Binding IsAddVendorModalOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#FFFFFF" CornerRadius="12" Width="680" MaxHeight="800" VerticalAlignment="Center" Padding="0" BorderBrush="#CBD5E1" BorderThickness="1">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Add New Vendor" Foreground="#0F172A" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="✕" Command="{Binding CloseAddVendorModalCommand}" Background="Transparent" Foreground="#64748B" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,0"/>
                        </Grid>
                    </Border>

                    <!-- Footer Actions -->
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="20,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CloseAddVendorModalCommand}" Background="Transparent" Foreground="#64748B" Padding="16,8" Margin="0,0,10,0"/>
                            <Button Content="💾 Create" Command="{Binding SaveVendorCommand}" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="20,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Form Fields -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                        <StackPanel>
                            <!-- Account Code -->
                            <TextBlock Text="ACCOUNT CODE (AUTO-GENERATED IF LEFT BLANK)" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedVendor.Code}" Margin="0,0,0,14" Padding="10,8" Background="#F8FAFC"/>

                            <!-- Row 1: Vendor Name & Contact Person -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="VENDOR NAME *" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.Name}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CONTACT PERSON" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.ContactPerson}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Vendor Type & Phone -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="VENDOR TYPE *" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ComboBox Text="{Binding SelectedVendor.VendorType}" SelectedIndex="0" Height="36">
                                        <ComboBoxItem Content="Supplier"/>
                                        <ComboBoxItem Content="Manufacturer"/>
                                        <ComboBoxItem Content="Wholesaler"/>
                                        <ComboBoxItem Content="Contractor"/>
                                        <ComboBoxItem Content="Service Provider"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PHONE *" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.Phone}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: NTN & GST Number -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NTN (NATIONAL TAX NUMBER)" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.NTN}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="GST NUMBER (SALES TAX REGISTRATION)" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.GSTNumber}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 4: Address -->
                            <TextBlock Text="ADDRESS" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedVendor.Address}" Height="55" TextWrapping="Wrap" Margin="0,0,0,14" Padding="10,8" Background="#F8FAFC"/>

                            <!-- Row 5: Region & Area -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="REGION" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ComboBox Text="{Binding SelectedVendor.Region}" SelectedIndex="0" Height="36">
                                        <ComboBoxItem Content="Select Region"/>
                                        <ComboBoxItem Content="Balochistan"/>
                                        <ComboBoxItem Content="Sindh"/>
                                        <ComboBoxItem Content="Punjab"/>
                                        <ComboBoxItem Content="KPK"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="AREA" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.Area}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 6: Postal Code & Country -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="POSTAL CODE" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.PostalCode}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="COUNTRY" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.Country}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 7: Credit Limit & Credit Days -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CREDIT LIMIT (PKR)" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.CreditLimit, StringFormat='{}{0:0}'}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CREDIT DAYS / PAYMENT TERMS" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.CreditDays}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 8: Vendor Payable & Advance Balance -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="VENDOR PAYABLE (WE OWE VENDOR)" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.OwesAmount, StringFormat='{}{0:0}'}" Background="#FEF2F2" BorderBrush="#FECDD3" Padding="10,8"/>
                                    <TextBlock Text="GOODS PURCHASED FROM VENDOR" Foreground="#94A3B8" FontSize="9" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ADVANCE BALANCE (VENDOR OWES US)" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.AdvanceAvailable, StringFormat='{}{0:0}'}" Background="#F0FDF4" BorderBrush="#BBF7D0" Padding="10,8"/>
                                    <TextBlock Text="PAYMENTS MADE TO VENDOR" Foreground="#94A3B8" FontSize="9" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 9: Net Balance & Status -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NET BALANCE" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="PKR 0" IsReadOnly="True" Background="#F1F5F9" Padding="10,8"/>
                                    <TextBlock Text="AUTO-CALCULATED (PAYABLE - ADVANCE)" Foreground="#94A3B8" FontSize="9" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="STATUS" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="Settled" IsReadOnly="True" Background="#F1F5F9" Padding="10,8"/>
                                    <TextBlock Text="AUTO-CALCULATED BASED ON BALANCES" Foreground="#94A3B8" FontSize="9" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- BANK DETAILS SECTION -->
                            <Separator Background="#E2E8F0" Margin="0,4,0,12"/>
                            <TextBlock Text="💳 BANK DETAILS" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="BANK NAME" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.BankName}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ACCOUNT NUMBER" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.BankAccountNumber}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="BRANCH" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedVendor.BankBranch}" Padding="10,8" Background="#F8FAFC"/>
                                </StackPanel>

                                <CheckBox Grid.Column="2" IsChecked="{Binding SelectedVendor.DeductWithholdingTax}" Content="Deduct Withholding Tax on payments" Foreground="#475569" FontSize="11" VerticalAlignment="Center" Margin="0,18,0,0"/>
                            </Grid>

                            <!-- Row 11: Notes -->
                            <TextBlock Text="WHAT THINGS I PURCHASED / NOTES" Foreground="#7A0C0C" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedVendor.Notes}" Height="50" TextWrapping="Wrap" Padding="10,8" Background="#F8FAFC"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- VENDOR MASTER DETAIL VIEW DIALOG OVERLAY -->
        <Grid Background="#80000000" Visibility="{Binding IsLedgerModalOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#F8FAFC" CornerRadius="12" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" BorderBrush="#CBD5E1" BorderThickness="1">
                <DockPanel>
                    <!-- Header Bar -->
                    <Border DockPanel.Dock="Top" Padding="20,14" Background="#7A0C0C" CornerRadius="12,12,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedVendorDto.Name}" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"/>
                                    <Border Background="#FDE047" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedVendorDto.Code}" Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedVendorDto.StatusText}" Foreground="#15803D" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedVendorDto.Phone, StringFormat='Phone: {0} | Complete Vendor Statement &amp; Supply History'}" Foreground="#E2E8F0" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding CloseLedgerModalCommand}" Content="← BACK TO VENDORS LIST" Background="#FFFFFF" Foreground="#0F172A" FontWeight="Bold" Padding="14,6" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding PrintVendorLedgerCommand}" Content="🖨️ Print Statement" Background="#FFFFFF" Foreground="#0F172A" FontWeight="Bold" Padding="12,6" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding CloseLedgerModalCommand}" Content="✕" Background="Transparent" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Padding="6,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Footer Bar -->
                    <Border DockPanel.Dock="Bottom" Padding="16,10" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="AL MADINA BUILDING MATERIAL ERP — VENDOR MASTER STATEMENT" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                            <Button Command="{Binding CloseLedgerModalCommand}" Content="← BACK TO VENDORS LIST" Background="#64748B" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,6" HorizontalAlignment="Right" Cursor="Hand"/>
                        </DockPanel>
                    </Border>

                    <!-- Scrollable Master Content Body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Top 4 Summary Metric Cards -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Total Purchases Value -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Total Purchases Value" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TotalPurchasesValue, StringFormat='PKR {0:N0}'}" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Total Payments Made -->
                                <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Total Payments Made" Foreground="#15803D" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TotalPaymentsMade, StringFormat='PKR {0:N0}'}" Foreground="#166534" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Last Purchase Info -->
                                <Border Grid.Column="4" Background="#FEF2F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Last Purchase" Foreground="#BE123C" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding LastPurchaseInfo}" Foreground="#9F1239" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Last Payment Info -->
                                <Border Grid.Column="6" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Last Payment / Cash-Bank" Foreground="#1D4ED8" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding LastPaymentInfo}" Foreground="#1E40AF" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Tabbed Sections Container -->
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16">
                                <TabControl SelectedIndex="{Binding SelectedDetailTabIndex}" Background="Transparent" BorderThickness="0">
                                    
                                    <!-- TAB 1: SUPPLIER PURCHASED ITEMS SUMMARY -->
                                    <TabItem Header="📦 Supplier Purchased Items Summary">
                                        <StackPanel Margin="0,12,0,0">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="460">
                                                <DataGrid ItemsSource="{Binding PurchasedItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All" HorizontalGridLinesBrush="#CBD5E1" VerticalGridLinesBrush="#CBD5E1" RowHeight="38" MinWidth="1250" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd HH:mm'}" Width="150"/>
                                                        <DataGridTextColumn Header="PURCHASE #" Binding="{Binding PurchaseNumber}" Width="140" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="VOUCHER #" Binding="{Binding VoucherNumber}" Width="130"/>
                                                        <DataGridTextColumn Header="ITEM CODE" Binding="{Binding ItemCode}" Width="120" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemName}" Width="240" FontWeight="SemiBold"/>
                                                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, StringFormat='{}{0:N0}'}" Width="90"/>
                                                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="80"/>
                                                        <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice, StringFormat='PKR {0:N0}'}" Width="120"/>
                                                        <DataGridTextColumn Header="TOTAL AMOUNT" Binding="{Binding TotalAmount, StringFormat='PKR {0:N0}'}" Width="140" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="PAID" Binding="{Binding PaidAmount, StringFormat='PKR {0:N0}'}" Width="120" Foreground="#16A34A"/>
                                                        <DataGridTextColumn Header="OUTSTANDING" Binding="{Binding OutstandingBalance, StringFormat='PKR {0:N0}'}" Width="140" Foreground="#DC2626" FontWeight="Bold"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ScrollViewer>

                                            <!-- Grand Total Row -->
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12" Margin="0,8,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="GRAND TOTAL" FontWeight="Bold" Foreground="#0F172A" FontSize="12" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding TotalPurchasedQty, StringFormat='Total Qty: {0:N0}'}" FontWeight="Bold" Margin="0,0,20,0"/>
                                                        <TextBlock Text="{Binding TotalPurchasedAmount, StringFormat='Total Amount: PKR {0:N0}'}" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,20,0"/>
                                                        <TextBlock Text="{Binding TotalPurchasedPaid, StringFormat='Total Paid: PKR {0:N0}'}" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,20,0"/>
                                                        <TextBlock Text="{Binding TotalPurchasedOutstanding, StringFormat='Outstanding: PKR {0:N0}'}" Foreground="#DC2626" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </TabItem>

                                    <!-- TAB 2: PAYMENT HISTORY -->
                                    <TabItem Header="💳 Payment &amp; Cash-Bank History">
                                        <StackPanel Margin="0,12,0,0">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="460">
                                                <DataGrid ItemsSource="{Binding PaymentHistory}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All" HorizontalGridLinesBrush="#CBD5E1" VerticalGridLinesBrush="#CBD5E1" RowHeight="38" MinWidth="1100" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd HH:mm'}" Width="150"/>
                                                        <DataGridTextColumn Header="VOUCHER #" Binding="{Binding VoucherNumber}" Width="150" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="TRANSACTION TYPE" Binding="{Binding TransactionType}" Width="180" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="PAYMENT MODE" Binding="{Binding Mode}" Width="140"/>
                                                        <DataGridTextColumn Header="AMOUNT PAID" Binding="{Binding Amount, StringFormat='PKR {0:N0}'}" Width="170" Foreground="#16A34A" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="REF INVOICE" Binding="{Binding ReferenceInvoice}" Width="150"/>
                                                        <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="250"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ScrollViewer>

                                            <!-- Grand Total Row -->
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12" Margin="0,8,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="GRAND TOTAL" FontWeight="Bold" Foreground="#0F172A" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TotalPaymentHistoryAmount, StringFormat='Total Payments Made: PKR {0:N0}'}" Foreground="#16A34A" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </TabItem>

                                    <!-- TAB 3: OUTSTANDING BILLS & INVOICES -->
                                    <TabItem Header="📄 Outstanding Bills &amp; Payables">
                                        <StackPanel Margin="0,12,0,0">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="460">
                                                <DataGrid ItemsSource="{Binding OutstandingInvoices}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All" HorizontalGridLinesBrush="#CBD5E1" VerticalGridLinesBrush="#CBD5E1" RowHeight="38" MinWidth="1150" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="INVOICE DATE" Binding="{Binding InvoiceDate, StringFormat='yyyy-MM-dd'}" Width="140"/>
                                                        <DataGridTextColumn Header="PURCHASE #" Binding="{Binding InvoiceNumber}" Width="150" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="VOUCHER #" Binding="{Binding VoucherNumber}" Width="140"/>
                                                        <DataGridTextColumn Header="PAYMENT TERMS" Binding="{Binding PaymentTerms}" Width="150"/>
                                                        <DataGridTextColumn Header="TOTAL AMOUNT" Binding="{Binding TotalAmount, StringFormat='PKR {0:N0}'}" Width="150" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="PAID AMOUNT" Binding="{Binding PaidAmount, StringFormat='PKR {0:N0}'}" Width="140" Foreground="#16A34A"/>
                                                        <DataGridTextColumn Header="BALANCE DUE" Binding="{Binding BalanceDue, StringFormat='PKR {0:N0}'}" Width="150" Foreground="#DC2626" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="130" FontWeight="Bold"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ScrollViewer>

                                            <!-- Grand Total Row -->
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12" Margin="0,8,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="GRAND TOTAL" FontWeight="Bold" Foreground="#0F172A" FontSize="12" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding TotalOutstandingInvoiceAmount, StringFormat='Total Invoices: PKR {0:N0}'}" FontWeight="Bold" Margin="0,0,20,0"/>
                                                        <TextBlock Text="{Binding TotalOutstandingPaidAmount, StringFormat='Total Paid: PKR {0:N0}'}" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,20,0"/>
                                                        <TextBlock Text="{Binding TotalOutstandingBalanceDue, StringFormat='Total Balance Due: PKR {0:N0}'}" Foreground="#DC2626" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </TabItem>

                                    <!-- TAB 4: VENDOR LEDGER STATEMENT -->
                                    <TabItem Header="📕 Full Vendor Ledger Statement">
                                        <StackPanel Margin="0,12,0,0">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="460">
                                                <DataGrid ItemsSource="{Binding VendorLedgerEntries}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All" HorizontalGridLinesBrush="#CBD5E1" VerticalGridLinesBrush="#CBD5E1" RowHeight="38" MinWidth="1100" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd HH:mm'}" Width="150"/>
                                                        <DataGridTextColumn Header="TRANSACTION TYPE" Binding="{Binding TransactionType}" Width="160" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="VOUCHER #" Binding="{Binding VoucherNumber}" Width="140"/>
                                                        <DataGridTextColumn Header="DEBIT (-)" Binding="{Binding Debit, StringFormat='PKR {0:N2}'}" Width="140" Foreground="#16A34A"/>
                                                        <DataGridTextColumn Header="CREDIT (+)" Binding="{Binding Credit, StringFormat='PKR {0:N2}'}" Width="140" Foreground="#DC2626"/>
                                                        <DataGridTextColumn Header="RUNNING BALANCE" Binding="{Binding RunningBalance, StringFormat='PKR {0:N2}'}" Width="160" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="ITEMS / DETAILS" Binding="{Binding ItemDetailsSummary}" Width="250"/>
                                                        <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="250"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ScrollViewer>

                                            <!-- Grand Total Row -->
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12" Margin="0,8,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="GRAND TOTAL" FontWeight="Bold" Foreground="#0F172A" FontSize="12" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding LedgerTotalDebit, StringFormat='Total Debit: PKR {0:N2}'}" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,20,0"/>
                                                        <TextBlock Text="{Binding LedgerTotalCredit, StringFormat='Total Credit: PKR {0:N2}'}" Foreground="#DC2626" FontWeight="Bold" Margin="0,0,20,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
