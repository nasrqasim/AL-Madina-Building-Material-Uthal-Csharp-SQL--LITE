<UserControl x:Class="AlMadinaERP.Wpf.Views.SalaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- ============================================================== -->
        <!-- SUB-VIEW 1: GENERAL JOURNAL PAGE (SCREENSHOT 1 MATCH)          -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SubViewMode}" Value="JournalList">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="General Journal" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Double entry manual transaction accounting records." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding PrintSalaryJournalCommand}" Content="🖨️ Print" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Command="{Binding ExportSalaryJournalCommand}" Content="📊 Export Excel" Visibility="Collapsed" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Command="{Binding OpenAddJournalModalCommand}" Content="+ ADD ENTRY" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Margin="3" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- STAT CARDS -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#EFF6FF" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="📄" Foreground="#2563EB" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL TRANSACTIONS" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalJournalTransactions}" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#DCFCE7" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="📈" Foreground="#16A34A" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL DEBITS" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalJournalDebits, StringFormat='PKR {0:N0}'}" Foreground="#16A34A" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#FEE2E2" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="📉" Foreground="#DC2626" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL CREDITS" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalJournalCredits, StringFormat='PKR {0:N0}'}" Foreground="#DC2626" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Height="34" Margin="0,0,0,14"/>

                        <DataGrid ItemsSource="{Binding JournalEntries}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="380" RowHeight="38" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" Width="110"/>
                                <DataGridTextColumn Header="VOUCHER #" Binding="{Binding VoucherNumber}" Width="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="ACCOUNT" Binding="{Binding AccountName}" Width="180" FontWeight="Bold"/>
                                <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="*"/>
                                <DataGridTextColumn Header="DEBIT" Binding="{Binding Debit, StringFormat='{}{0:N0}'}" Width="110" FontWeight="Bold" Foreground="#16A34A"/>
                                <DataGridTextColumn Header="CREDIT" Binding="{Binding Credit, StringFormat='{}{0:N0}'}" Width="110" FontWeight="Bold" Foreground="#DC2626"/>
                                <DataGridTemplateColumn Header="ACTIONS" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.DeleteJournalEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="🗑️" Padding="2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- SUB-VIEW 2: SALARY STAFF LIST VIEW (SCREENSHOT 2 MATCH)        -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SubViewMode}" Value="StaffList">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Salary Staff" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Managing employee information, salary structure, and payroll records." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding PrintSalaryStaffListCommand}" Content="🖨️ Print" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Command="{Binding ExportSalaryStaffListCommand}" Content="📊 Export Excel" Visibility="Collapsed" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Command="{Binding OpenPaySalaryModalCommand}" Content="$ PAY SALARY" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Margin="3" FontSize="12" Cursor="Hand"/>
                        <Button Command="{Binding OpenAddStaffModalCommand}" Content="+ ADD SALARY STAFF" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Margin="3" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- 2 STAT CARDS FOR SALARY STAFF -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#EFF6FF" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="👥" Foreground="#2563EB" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL EMPLOYEES" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Staffs.Count}" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#FEE2E2" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="💵" Foreground="#DC2626" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="GRAND TOTAL BASIC SALARY" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalBasicSalaries, StringFormat='PKR {0:N0}'}" Foreground="#DC2626" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Height="34" Margin="0,0,0,14"/>

                        <DataGrid ItemsSource="{Binding Staffs}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="380" RowHeight="42" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STAFF CODE" Binding="{Binding StaffCode}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="170" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DESIGNATION / DEPT" Binding="{Binding Designation}" Width="*"/>
                                <DataGridTextColumn Header="JOINING DATE" Binding="{Binding JoiningDate, StringFormat='dd/MM/yyyy'}" Width="120"/>
                                <DataGridTextColumn Header="BASIC SALARY" Binding="{Binding BasicSalary, StringFormat='PKR {0:N0}'}" Width="130" FontWeight="Bold" Foreground="#DC2626"/>
                                <DataGridTemplateColumn Header="STATUS" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="ACTIVE" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ACTIONS" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.OpenPaySalaryModalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="$ PAY SALARY" Background="#059669" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Padding="8,4" Margin="2,0" Cursor="Hand"/>
                                                <Button Command="{Binding DataContext.ViewStaffLedgerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="👁️ VIEW LEDGER" Background="#2563EB" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Padding="8,4" Margin="2,0" Cursor="Hand"/>
                                                <Button Command="{Binding DataContext.DeleteStaffCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="🗑️" Padding="4,2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- SUB-VIEW 3: SALARY ADVANCE LIST VIEW (SCREENSHOT 2 MATCH)      -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SubViewMode}" Value="AdvanceList">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Salary Advance" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Process and track salary advances for employees." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding PrintSalaryAdvancesCommand}" Content="🖨️ Print" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Command="{Binding ExportSalaryAdvancesCommand}" Content="📊 Export Excel" Visibility="Collapsed" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Command="{Binding OpenNewAdvanceFormCommand}" Content="+ NEW ADVANCE" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Margin="3" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Height="34" Margin="0,0,0,14"/>

                        <DataGrid ItemsSource="{Binding SalaryAdvances}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="380" RowHeight="38" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VOUCHER NO" Binding="{Binding VoucherNumber}" Width="140" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" Width="110"/>
                                <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding StaffName}" Width="180" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="*"/>
                                <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='PKR {0:N0}'}" Width="120" FontWeight="Bold" Foreground="#DC2626"/>
                                <DataGridTextColumn Header="RECOVERY MONTH" Binding="{Binding RecoveryMonth}" Width="140"/>
                                <DataGridTemplateColumn Header="STATUS" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ACTIONS" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.DeleteSalaryAdvanceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="🗑️" Padding="2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- SUB-VIEW 4: NEW SALARY ADVANCE FORM VIEW (SCREENSHOT 1 MATCH)  -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SubViewMode}" Value="AdvanceForm">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel HorizontalAlignment="Center" Width="840">
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="New Salary Advance Request" Foreground="#0F172A" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseAdvanceFormCommand}" Content="Cancel" Background="#E2E8F0" Foreground="#1E293B" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Command="{Binding SaveSalaryAdvanceCommand}" Content="Submit Advance Request" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,6" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="EMPLOYEE *" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <ComboBox ItemsSource="{Binding Staffs}" SelectedItem="{Binding SelectedStaff}" DisplayMemberPath="FullName" Height="34" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ADVANCE AMOUNT *" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding NewSalaryAdvance.Amount, StringFormat='{}{0:0.00}'}" Height="34" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DATE OF ADVANCE *" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <DatePicker SelectedDate="{Binding NewSalaryAdvance.Date}" Height="34" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RECOVERY MONTH *" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding NewSalaryAdvance.RecoveryMonth}" Height="34" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="STATUS" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                        <ComboBox Text="{Binding NewSalaryAdvance.Status, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="0" Height="34" Margin="0,4,0,14">
                            <ComboBoxItem Content="Approved"/>
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Rejected"/>
                        </ComboBox>

                        <TextBlock Text="REMARKS / REASON" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                        <TextBox Text="{Binding NewSalaryAdvance.Remarks}" Height="60" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- SUB-VIEW 5: EMPLOYEE LEDGER PAGE (SCREENSHOT 5 MATCH)          -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SubViewMode}" Value="StaffLedger">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel HorizontalAlignment="Center" Width="900">
                <Grid Margin="0,0,0,14">
                    <Button Command="{Binding CloseStaffLedgerCommand}" Content="← Employee Ledger" Background="Transparent" Foreground="#0F172A" FontSize="18" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding PrintStaffLedgerCommand}" Content="🖨️ Print Ledger" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" Margin="4,0" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- MAROON BANNER CARD -->
                <Border Background="#7A0C0C" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FFFFFF" CornerRadius="20" Width="40" Height="40" Margin="0,0,14,0">
                                <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedStaff.FullName, FallbackValue='Staff Member'}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedStaff.StaffCode, FallbackValue='STF-001'}" Foreground="#F87171" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#FFFFFF" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="BASIC SALARY" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedStaff.BasicSalary, StringFormat='PKR {0:N0}', FallbackValue='PKR 0'}" Foreground="#0F172A" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Button Command="{Binding OpenPaySalaryModalCommand}" CommandParameter="{Binding SelectedStaff}" Content="$ PAY SALARY" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2 STAT CARDS -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="💲 TOTAL SALARY PAID" Foreground="#059669" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedStaff.TotalSalaryPaid, StringFormat='PKR {0:N0}', FallbackValue='PKR 0'}" Foreground="#0F172A" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="〽️ TOTAL ADVANCES TAKEN" Foreground="#D97706" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedStaff.TotalAdvances, StringFormat='PKR {0:N0}', FallbackValue='PKR 0'}" Foreground="#0F172A" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CARD 1: MONTHLY SALARY LEDGER & YEAR/MONTH FILTER -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="📅 Monthly Salary Ledger Filter" Foreground="#0F172A" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Month:" Foreground="#475569" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox SelectedValue="{Binding SelectedLedgerMonth, Mode=TwoWay}" SelectedValuePath="Tag" Height="30" FontSize="11" Width="120" Margin="0,0,12,0">
                                    <ComboBoxItem Content="All Months" Tag="All" IsSelected="True"/>
                                    <ComboBoxItem Content="January" Tag="January"/>
                                    <ComboBoxItem Content="February" Tag="February"/>
                                    <ComboBoxItem Content="March" Tag="March"/>
                                    <ComboBoxItem Content="April" Tag="April"/>
                                    <ComboBoxItem Content="May" Tag="May"/>
                                    <ComboBoxItem Content="June" Tag="June"/>
                                    <ComboBoxItem Content="July" Tag="July"/>
                                    <ComboBoxItem Content="August" Tag="August"/>
                                    <ComboBoxItem Content="September" Tag="September"/>
                                    <ComboBoxItem Content="October" Tag="October"/>
                                    <ComboBoxItem Content="November" Tag="November"/>
                                    <ComboBoxItem Content="December" Tag="December"/>
                                </ComboBox>

                                <TextBlock Text="Year:" Foreground="#475569" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Command="{Binding PrevLedgerYearCommand}" Content="◄" Padding="6,2" Background="#E2E8F0" BorderThickness="0" Cursor="Hand"/>
                                <TextBlock Text="{Binding SelectedLedgerYear}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="8,0"/>
                                <Button Command="{Binding NextLedgerYearCommand}" Content="►" Padding="6,2" Background="#E2E8F0" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: COMPLETE TRANSACTION LEDGER (SALARIES & ADVANCES) -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="📜 Complete Transaction Ledger (Salaries &amp; Advances)" Foreground="#0F172A" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>
                        <DataGrid ItemsSource="{Binding StaffLedgerRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="220" RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" Width="110"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="DEBIT (PAID OUT)" Binding="{Binding PaidOut, StringFormat='PKR {0:N0}'}" Width="140" FontWeight="Bold" Foreground="#16A34A"/>
                                <DataGridTextColumn Header="CREDIT / DEDUCTION" Binding="{Binding AdvanceReceived, StringFormat='PKR {0:N0}'}" Width="150" FontWeight="Bold" Foreground="#DC2626"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- MODAL DIALOG: NEW SALARY STAFF FORM (SCREENSHOT 3 MATCH)       -->
        <!-- ============================================================== -->
        <Grid Background="#80000000" Visibility="{Binding IsAddStaffModalOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#FFFFFF" CornerRadius="10" Width="680" VerticalAlignment="Center" Padding="24" MaxHeight="680">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="New Salary Staff" Foreground="#0F172A" FontSize="18" FontWeight="Bold"/>
                            <Button Command="{Binding CloseAddStaffModalCommand}" Content="✕" Background="Transparent" Foreground="#64748B" FontSize="16" HorizontalAlignment="Right" Padding="4,0" Cursor="Hand"/>
                        </Grid>

                        <!-- PERSONAL INFO -->
                        <TextBlock Text="👤 PERSONAL INFO" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STAFF CODE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding NewStaff.StaffCode}" IsReadOnly="True" Background="#F1F5F9" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FULL NAME *" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding NewStaff.FullName}" Height="32"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CNIC" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding NewStaff.CNIC}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PHONE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding NewStaff.Phone}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- HR DETAILS -->
                        <TextBlock Text="🏛️ HR DETAILS" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" Margin="0,10,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DESIGNATION" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding NewStaff.Designation}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DEPARTMENT" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding NewStaff.Department}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="JOINING DATE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <DatePicker SelectedDate="{Binding NewStaff.JoiningDate}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- BANK FOR SALARY DEPOSIT -->
                        <TextBlock Text="🏦 BANK FOR SALARY DEPOSIT" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" Margin="0,10,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="BANK NAME" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding NewStaff.BankName}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ACCOUNT NO" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <TextBox Text="{Binding NewStaff.AccountNumber}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- SALARY STRUCTURE -->
                        <TextBlock Text="💵 SALARY STRUCTURE" Foreground="#7A0C0C" FontSize="11" FontWeight="Bold" Margin="0,10,0,10"/>
                        <TextBlock Text="BASIC SALARY *" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                        <TextBox Text="{Binding NewStaff.BasicSalary, StringFormat='{}{0:0.00}'}" Height="34" Margin="0,4,0,16"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Command="{Binding CloseAddStaffModalCommand}" Content="Cancel" Background="#E2E8F0" Foreground="#1E293B" Padding="16,8" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Command="{Binding SaveStaffCommand}" Content="💾 Save Staff" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="20,8" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODAL DIALOG: PAY EMPLOYEE SALARY (SCREENSHOT 4 MATCH)         -->
        <!-- ============================================================== -->
        <Grid Background="#80000000" Visibility="{Binding IsPaySalaryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#FFFFFF" CornerRadius="10" Width="440" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💲" Foreground="#059669" FontSize="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Pay Employee Salary" Foreground="#0F172A" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Command="{Binding ClosePaySalaryModalCommand}" Content="✕" Background="Transparent" Foreground="#64748B" FontSize="16" HorizontalAlignment="Right" Padding="4,0" Cursor="Hand"/>
                    </Grid>

                    <TextBlock Text="Select Employee" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding Staffs}" SelectedItem="{Binding SelectedStaff}" DisplayMemberPath="FullName" Height="34" Margin="0,4,0,10"/>

                    <TextBlock Text="Salary Amount (PKR)" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                    <TextBox Text="{Binding NewSalary.BasicSalary, StringFormat='{}{0:0.00}'}" Height="34" Margin="0,4,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Payment Method" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                            <ComboBox Text="{Binding NewSalary.PaymentMode, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="0" Height="34" Margin="0,4,0,0">
                                <ComboBoxItem Content="Cash"/>
                                <ComboBoxItem Content="Bank Transfer"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Date" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                            <DatePicker SelectedDate="{Binding NewSalary.Date}" Height="34" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Remarks / Month" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                    <TextBox Text="{Binding NewSalary.Remarks}" Height="34" Margin="0,4,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ClosePaySalaryModalCommand}" Content="Cancel" Background="#E2E8F0" Foreground="#1E293B" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Command="{Binding SaveSalaryCommand}" Content="Confirm &amp; Pay" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,6" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODAL DIALOG: ADD JOURNAL ENTRY                                -->
        <!-- ============================================================== -->
        <Grid Background="#80000000" Visibility="{Binding IsAddJournalModalOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#FFFFFF" CornerRadius="10" Width="480" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Add Journal Entry" Foreground="#0F172A" FontSize="18" FontWeight="Bold"/>
                        <Button Command="{Binding CloseAddJournalModalCommand}" Content="✕" Background="Transparent" Foreground="#64748B" FontSize="16" HorizontalAlignment="Right" Padding="4,0" Cursor="Hand"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="VOUCHER #" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                            <TextBox Text="{Binding NewJournalEntry.VoucherNumber}" IsReadOnly="True" Background="#F1F5F9" Height="34" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DATE" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                            <DatePicker SelectedDate="{Binding NewJournalEntry.Date}" Height="34" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="ACCOUNT NAME *" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                    <TextBox Text="{Binding NewJournalEntry.AccountName}" Height="34" Margin="0,4,0,10"/>

                    <TextBlock Text="REMARKS / PARTICULARS" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                    <TextBox Text="{Binding NewJournalEntry.Remarks}" Height="40" TextWrapping="Wrap" Margin="0,4,0,10"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DEBIT AMOUNT (PKR)" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                            <TextBox Text="{Binding NewJournalEntry.Debit, StringFormat='{}{0:0.00}'}" Height="34" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CREDIT AMOUNT (PKR)" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                            <TextBox Text="{Binding NewJournalEntry.Credit, StringFormat='{}{0:0.00}'}" Height="34" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseAddJournalModalCommand}" Content="Cancel" Background="#E2E8F0" Foreground="#1E293B" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Command="{Binding SaveJournalEntryCommand}" Content="SAVE ENTRY" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,6" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
