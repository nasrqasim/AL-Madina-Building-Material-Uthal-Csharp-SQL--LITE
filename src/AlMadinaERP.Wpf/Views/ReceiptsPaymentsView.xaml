<UserControl x:Class="AlMadinaERP.Wpf.Views.ReceiptsPaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AlMadinaERP.Wpf.ViewModels"
             Background="#F8FAFC">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- ============================================================== -->
        <!-- SUB-VIEW 1: CASH RECEIPT LIST VIEW                             -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveSubView}" Value="CashReceiptList">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cash Receipt" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Record and manage all cash received from customers and other sources." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding PrintCashReceiptListCommand}" Content="🖨️ Print List" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Content="📊 Export Excel" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold"/>
                        <Button Command="{Binding OpenNewCashReceiptFormCommand}" Content="+ NEW CASH RECEIPT" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Margin="3" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ReceiptSearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" Height="34" VerticalContentAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedIndex="0" Margin="0,0,10,0" Height="34">
                                <ComboBoxItem Content="All Duration"/>
                                <ComboBoxItem Content="Today"/>
                                <ComboBoxItem Content="This Month"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" SelectedIndex="0" Margin="0,0,10,0" Height="34">
                                <ComboBoxItem Content="All Cashier"/>
                                <ComboBoxItem Content="Admin"/>
                            </ComboBox>
                            <ComboBox Grid.Column="3" SelectedIndex="0" Height="34">
                                <ComboBoxItem Content="All Variable"/>
                                <ComboBoxItem Content="Posted"/>
                                <ComboBoxItem Content="Draft"/>
                            </ComboBox>
                        </Grid>

                        <DataGrid ItemsSource="{Binding CashReceipts}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="380" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VOUCHER #" Binding="{Binding ReceiptNumber}" Width="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" Width="110"/>
                                <DataGridTemplateColumn Header="RECEIPT TYPE" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="CUSTOMER RECEIPT" Foreground="#2563EB" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CUSTOMER / ACCOUNT" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="RECEIVED BY / BANK" Binding="{Binding ReceivedBy}" Width="150"/>
                                <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='PKR {0:N2}'}" Width="120" FontWeight="Bold" Foreground="#16A34A"/>
                                <DataGridTemplateColumn Header="STATUS" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ACTIONS" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding DataContext.ViewReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="👁️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" ToolTip="View Receipt"/>
                                                <Button Command="{Binding DataContext.PrintReceiptVoucherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="🖨️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#059669" BorderThickness="0" Cursor="Hand" ToolTip="Print Voucher"/>
                                                <Button Command="{Binding DataContext.EditReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="✏️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#D97706" BorderThickness="0" Cursor="Hand" ToolTip="Edit Receipt"/>
                                                <Button Command="{Binding DataContext.DeleteReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="🗑️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" ToolTip="Delete Receipt"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- SUB-VIEW 2: BANK RECEIPT LIST VIEW                             -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveSubView}" Value="BankReceiptList">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bank Receipt" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Record and track all bank transfers and cheque deposits." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding PrintBankReceiptListCommand}" Content="🖨️ Print List" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Content="📊 Export Excel" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold"/>
                        <Button Command="{Binding OpenNewBankReceiptFormCommand}" Content="+ NEW BANK RECEIPT" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Margin="3" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBox Text="{Binding ReceiptSearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Height="34" Margin="0,0,0,14"/>

                        <DataGrid ItemsSource="{Binding BankReceipts}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="380" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VOUCHER #" Binding="{Binding ReceiptNumber}" Width="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" Width="110"/>
                                <DataGridTextColumn Header="CUSTOMER / PAYER" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="BANK NAME" Binding="{Binding BankName}" Width="150"/>
                                <DataGridTextColumn Header="ACCOUNT #" Binding="{Binding BankAccountNo}" Width="140"/>
                                <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='PKR {0:N2}'}" Width="120" FontWeight="Bold" Foreground="#16A34A"/>
                                <DataGridTemplateColumn Header="STATUS" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ACTIONS" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding DataContext.ViewReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="👁️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" ToolTip="View Receipt"/>
                                                <Button Command="{Binding DataContext.PrintReceiptVoucherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="🖨️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#059669" BorderThickness="0" Cursor="Hand" ToolTip="Print Voucher"/>
                                                <Button Command="{Binding DataContext.EditReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="✏️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#D97706" BorderThickness="0" Cursor="Hand" ToolTip="Edit Receipt"/>
                                                <Button Command="{Binding DataContext.DeleteReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="🗑️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" ToolTip="Delete Receipt"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- SUB-VIEW 3: CASH PAYMENT LIST VIEW (SCREENSHOT 1 MATCH)        -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveSubView}" Value="CashPaymentList">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cash Payment" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Record and manage cash payments made to vendors and suppliers." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding PrintCashPaymentListCommand}" Content="🖨️ Print List" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Content="📊 Export Excel" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold"/>
                        <Button Command="{Binding OpenNewCashPaymentFormCommand}" Content="+ NEW CASH PAYMENT" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Margin="3" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBox Text="{Binding PaymentSearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Height="34" Margin="0,0,0,14"/>

                        <DataGrid ItemsSource="{Binding CashPayments}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="380" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VOUCHER #" Binding="{Binding PaymentNumber}" Width="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" Width="110"/>
                                <DataGridTemplateColumn Header="PAYMENT TYPE" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="PARTY PAYMENT" Foreground="#2563EB" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PARTY / VENDOR" Binding="{Binding PartyName}" Width="*"/>
                                <DataGridTextColumn Header="PAYMENT METHOD / BANK" Binding="{Binding PaidFrom}" Width="150"/>
                                <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='PKR {0:N2}'}" Width="120" FontWeight="Bold" Foreground="#DC2626"/>
                                <DataGridTemplateColumn Header="STATUS" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ACTIONS" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding DataContext.ViewPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="👁️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" ToolTip="View Payment"/>
                                                <Button Command="{Binding DataContext.PrintPaymentVoucherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="🖨️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#059669" BorderThickness="0" Cursor="Hand" ToolTip="Print Voucher"/>
                                                <Button Command="{Binding DataContext.EditPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="✏️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#D97706" BorderThickness="0" Cursor="Hand" ToolTip="Edit Payment"/>
                                                <Button Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="🗑️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" ToolTip="Delete Payment"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- SUB-VIEW 4: BANK PAYMENT LIST VIEW (SCREENSHOT 3 MATCH)        -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveSubView}" Value="BankPaymentList">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bank Payment" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Record and manage bank transfers and outgoing cheque payments." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding PrintBankPaymentListCommand}" Content="🖨️ Print List" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Content="📊 Export Excel" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="3" FontSize="11" FontWeight="SemiBold"/>
                        <Button Command="{Binding OpenNewBankPaymentFormCommand}" Content="+ NEW BANK PAYMENT" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Margin="3" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBox Text="{Binding PaymentSearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Height="34" Margin="0,0,0,14"/>

                        <DataGrid ItemsSource="{Binding BankPayments}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="380" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VOUCHER #" Binding="{Binding PaymentNumber}" Width="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" Width="110"/>
                                <DataGridTextColumn Header="PARTY / VENDOR" Binding="{Binding PartyName}" Width="*"/>
                                <DataGridTextColumn Header="BANK NAME" Binding="{Binding BankName}" Width="150"/>
                                <DataGridTextColumn Header="ACCOUNT #" Binding="{Binding BankAccountNo}" Width="140"/>
                                <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='PKR {0:N2}'}" Width="120" FontWeight="Bold" Foreground="#DC2626"/>
                                <DataGridTemplateColumn Header="STATUS" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ACTIONS" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding DataContext.ViewPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="👁️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" ToolTip="View Payment"/>
                                                <Button Command="{Binding DataContext.PrintPaymentVoucherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="🖨️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#059669" BorderThickness="0" Cursor="Hand" ToolTip="Print Voucher"/>
                                                <Button Command="{Binding DataContext.EditPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="✏️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#D97706" BorderThickness="0" Cursor="Hand" ToolTip="Edit Payment"/>
                                                <Button Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="🗑️" Padding="3,1" Margin="2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" ToolTip="Delete Payment"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- SUB-VIEW 8: NEW CASH / BANK RECEIPT FORM VIEW                  -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveSubView}" Value="CashReceiptForm">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveSubView}" Value="BankReceiptForm">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel HorizontalAlignment="Center" Width="840">
                <!-- TOP NAVBAR TOOLBAR -->
                <Grid Margin="0,0,0,16">
                    <Button Command="{Binding CloseSubViewCommand}" Content="← Cancel" Background="Transparent" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding SaveReceiptDraftCommand}" Content="💾 Save Draft" Background="#78350F" Foreground="#FFFFFF" Padding="14,6" Margin="4,0" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                        <Button Command="{Binding SaveReceiptPostedCommand}" Content="💾 Save &amp; Post" Background="#16A34A" Foreground="#FFFFFF" Padding="14,6" Margin="4,0" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- MODE TOGGLE PILLS -->
                <Border Background="#E2E8F0" CornerRadius="20" HorizontalAlignment="Center" Padding="4" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SwitchReceiptModeCommand}" CommandParameter="Cash" Content="Cash Receipt" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,6" BorderThickness="0" Cursor="Hand"/>
                        <Button Command="{Binding SwitchReceiptModeCommand}" CommandParameter="Bank" Content="Bank Receipt" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,6" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- 2-COLUMN FORM LAYOUT -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="RECEIPT DETAILS" Foreground="#0F172A" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="VOUCHER NO" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                        <TextBox Text="{Binding NewReceipt.ReceiptNumber}" IsReadOnly="True" Background="#F1F5F9" Height="32" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DATE *" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                        <DatePicker SelectedDate="{Binding NewReceipt.Date}" Height="32" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="RECEIVED FROM (CUSTOMER) *" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Text="{Binding NewReceipt.CustomerName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="32" Margin="0,4,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="BANK ACCOUNT *" Foreground="#475569" FontSize="10" FontWeight="Bold"/>
                                        <ComboBox ItemsSource="{Binding Banks}" SelectedItem="{Binding SelectedBank}" DisplayMemberPath="BankName" Text="{Binding NewReceipt.BankName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="32" Margin="0,4,0,0"/>
                                    </StackPanel>
