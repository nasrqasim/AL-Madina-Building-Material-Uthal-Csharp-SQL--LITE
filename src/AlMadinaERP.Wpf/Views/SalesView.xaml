                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="BALANCE DUE" Foreground="#EF4444" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NewInvoice.BalanceDue, StringFormat='{}{0:N2}'}" Foreground="#EF4444" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- PROMINENT BOTTOM SAVE ACTION BUTTONS -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding SaveInvoiceDraftCommand}" Content="💾 SAVE DRAFT" Background="#78350F" Foreground="#FFFFFF" Padding="12,12" Margin="0,0,6,0" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
                                    <Button Grid.Column="1" Command="{Binding SaveInvoicePostedCommand}" Content="💾 SAVE &amp; POST" Background="#16A34A" Foreground="#FFFFFF" Padding="12,12" Margin="6,0,0,0" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- SUB-VIEW 3: POS COUNTER SALE LIST VIEW (SCREENSHOT 3 MATCH)    -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
