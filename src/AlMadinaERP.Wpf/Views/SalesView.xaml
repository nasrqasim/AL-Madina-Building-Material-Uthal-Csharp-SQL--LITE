                            <Border DockPanel.Dock="Right" Background="#ECFDF5" CornerRadius="20" Width="40" Height="40">
                                <TextBlock Text="💵" Foreground="#059669" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL CASH" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalPosCash, StringFormat='Rs.{0:N0}'}" Foreground="#059669" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
