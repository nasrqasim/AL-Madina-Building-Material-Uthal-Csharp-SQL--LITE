                                <TextBlock Text="{Binding NewInvoice.TotalAmount, StringFormat='Rs. {0:N0}'}" Foreground="#7A0C0C" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button Command="{Binding SaveInvoicePostedCommand}" Content="⚡ PAY &amp; PRINT RECEIPT" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Padding="0,12" Cursor="Hand"/>
