<UserControl x:Class="AlMadinaERP.Wpf.Views.CustomerOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid>
        <!-- Main Customer Orders Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- TOP HEADER BAR -->
                <Grid Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Customer Orders" Foreground="#0F172A" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Order Management / Customer Orders" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🖨️ Print List" Command="{Binding PrintOrdersListCommand}" Background="#E2E8F0" Foreground="#1E293B" Padding="12,6" Margin="3" Cursor="Hand" FontWeight="SemiBold"/>
                        <Button Content="+ NEW CUSTOMER ORDER" Command="{Binding OpenNewOrderModalCommand}" Background="#7A0C0C" Foreground="#FFFFFF" Padding="14,6" Margin="3" Cursor="Hand" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- 4 TOP SUMMARY CARDS -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Total Orders" Foreground="#047857" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalOrdersCount}" Foreground="#065F46" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Pending Orders" Foreground="#B45309" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PendingOrdersCount}" Foreground="#92400E" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Completed Orders" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CompletedOrdersCount}" Foreground="#1E40AF" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Total Order Amount" Foreground="#6D28D9" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalOrdersAmount, StringFormat='Rs. {0:N0}'}" Foreground="#5B21B6" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FILTER BAR -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="All Orders" Command="{Binding FilterStatusCommand}" CommandParameter="All" Background="#7A0C0C" Foreground="#FFFFFF" Padding="14,6" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Content="Pending" Command="{Binding FilterStatusCommand}" CommandParameter="Pending" Background="#F1F5F9" Foreground="#334155" Padding="14,6" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Content="Completed" Command="{Binding FilterStatusCommand}" CommandParameter="Completed" Background="#F1F5F9" Foreground="#334155" Padding="14,6" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="380" HorizontalAlignment="Left" Padding="10,6" Margin="0" VerticalAlignment="Center" ToolTip="Search by Customer Name, Order Number (CO-00001), Serial Number, Contact Number..."/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="🖨️ Print List" Command="{Binding PrintOrdersListCommand}" Background="#E2E8F0" Foreground="#1E293B" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="+ NEW CUSTOMER ORDER" Command="{Binding OpenNewOrderModalCommand}" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- CUSTOMER ORDERS DATAGRID TABLE -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <DataGrid ItemsSource="{Binding Orders}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="400" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SR #" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="ORDER NO." Binding="{Binding OrderNumber}" Width="110" FontWeight="Bold"/>
                                <DataGridTextColumn Header="CUSTOMER NAME" Binding="{Binding CustomerName}" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="CONTACT" Binding="{Binding ContactNumber}" Width="120"/>
                                <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="160"/>
                                <DataGridTextColumn Header="ORDER DATE" Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy'}" Width="110"/>
                                <DataGridTextColumn Header="RECEIVING DATE" Binding="{Binding ReceivingDate, StringFormat='dd/MM/yyyy'}" Width="120"/>
                                <DataGridTextColumn Header="ITEMS" Binding="{Binding TotalItems}" Width="70" ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                <DataGridTextColumn Header="TOTAL AMOUNT" Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" Width="140" FontWeight="Bold" Foreground="#7A0C0C"/>

                                <DataGridTemplateColumn Header="STATUS" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ToggleOrderStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                <Border CornerRadius="12" Padding="10,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                    <Setter Property="Background" Value="#FFFBEB"/>
                                                                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Foreground" Value="#047857"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="ACTIONS" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="👁️ View" Command="{Binding DataContext.ViewOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,3" Margin="2" Background="#F1F5F9" Foreground="#0F172A" Cursor="Hand" ToolTip="View Order Details"/>
                                                <Button Content="✏️ Edit" Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,3" Margin="2" Background="#EFF6FF" Foreground="#2563EB" Cursor="Hand" ToolTip="Edit Order"/>
                                                <Button Content="🗑️ Delete" Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,3" Margin="2" Background="#FEF2F2" Foreground="#DC2626" Cursor="Hand" ToolTip="Delete Order"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border DockPanel.Dock="Bottom" Background="#F1F5F9" Padding="16,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock Text="TOTAL ORDERS DISPLAYED:" Foreground="#0F172A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Orders.Count, StringFormat='Orders Count: {0}'}" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,0,20,0"/>
                                    <TextBlock Text="{Binding TotalOrdersAmount, StringFormat='Total Value: Rs. {0:N2}'}" Foreground="#7A0C0C" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ADD / EDIT CUSTOMER ORDER MODAL DIALOG OVERLAY -->
        <Grid Background="#80000000" Visibility="{Binding IsOrderModalOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#FFFFFF" CornerRadius="12" Width="820" MaxHeight="850" VerticalAlignment="Center" Padding="0" BorderBrush="#CBD5E1" BorderThickness="1">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Padding="20,16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="{Binding ModalTitle}" Foreground="#0F172A" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="✕" Command="{Binding CloseOrderModalCommand}" Background="Transparent" Foreground="#64748B" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Footer Actions -->
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="20,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL ORDER AMOUNT: " Foreground="#0F172A" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FormTotalAmount, StringFormat='Rs. {0:N2}'}" Foreground="#7A0C0C" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding CloseOrderModalCommand}" Background="Transparent" Foreground="#64748B" Padding="16,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="💾 Save Customer Order" Command="{Binding SaveOrderCommand}" Background="#7A0C0C" Foreground="#FFFFFF" Padding="20,8" FontWeight="Bold" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Body Content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Notice Banner: Optional Fields & Isolation -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                <TextBlock Text="ℹ️ All customer details are optional and specific ONLY to this order. Master customer accounts &amp; inventory stock will NOT be modified." Foreground="#1D4ED8" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Customer Information Section -->
                            <TextBlock Text="CUSTOMER DETAILS" Foreground="#0F172A" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Customer Name (Optional)" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormCustomerName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Contact Number (Optional)" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormContactNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Address (Optional)" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Order Date" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding FormOrderDate}" Padding="4"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Receiving Date" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding FormReceivingDate}" Padding="4"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,4,0,14" Background="#E2E8F0"/>

                            <!-- Order Items Section -->
                            <TextBlock Text="ORDER ITEMS" Foreground="#0F172A" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                            <!-- Add Item Row -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Select From Master Items" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding MasterItems}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedMasterItem}" Padding="8,5" IsEditable="True"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Item Description" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Quantity" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NewItemQuantity, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Unit" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NewItemUnit, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Selling Rate" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NewItemRate, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Line Total" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <Border Background="#E2E8F0" Padding="8,6" CornerRadius="4">
                                                <TextBlock Text="{Binding NewItemLineTotal, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" Foreground="#0F172A"/>
                                            </Border>
                                        </StackPanel>

                                        <Button Grid.Column="8" Content="+ Add Line Item" Command="{Binding AddItemLineCommand}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" VerticalAlignment="Bottom" Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Added Items Table -->
                            <DataGrid ItemsSource="{Binding CurrentOrderItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="160" MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemNameSnapshot}" Width="*" MinWidth="160"/>
                                    <DataGridTextColumn Header="CODE" Binding="{Binding ItemCode}" Width="90"/>
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="80" ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="80"/>
                                    <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat='Rs. {0:N2}'}" Width="110"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal, StringFormat='Rs. {0:N2}'}" Width="120" FontWeight="Bold" Foreground="#047857"/>

                                    <DataGridTemplateColumn Header="REMOVE" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕ Remove" Command="{Binding DataContext.RemoveItemLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#FEF2F2" Foreground="#DC2626" Padding="6,2" FontSize="10" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- VIEW CUSTOMER ORDER MODAL DIALOG OVERLAY -->
        <Grid Background="#80000000" Visibility="{Binding IsViewModalOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#FFFFFF" CornerRadius="12" Width="720" MaxHeight="800" VerticalAlignment="Center" Padding="0" BorderBrush="#CBD5E1" BorderThickness="1">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Padding="20,16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Customer Order Details (" Foreground="#0F172A" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedOrder.OrderNumber}" Foreground="#7A0C0C" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text=")" Foreground="#0F172A" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <Button Content="✕" Command="{Binding CloseViewModalCommand}" Background="Transparent" Foreground="#64748B" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Footer Actions -->
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="20,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🖨️ Print Order Voucher" Command="{Binding PrintCustomerOrderCommand}" CommandParameter="{Binding SelectedOrder}" Background="#0F172A" Foreground="#FFFFFF" Padding="16,8" Margin="0,0,10,0" FontWeight="Bold" Cursor="Hand"/>
                            <Button Content="Close" Command="{Binding CloseViewModalCommand}" Background="#E2E8F0" Foreground="#1E293B" Padding="16,8" FontWeight="SemiBold" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- View Body Content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CUSTOMER INFORMATION" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedOrder.CustomerName}" Foreground="#0F172A" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedOrder.ContactNumber, StringFormat='Phone: {0}'}" Foreground="#475569" FontSize="12" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedOrder.Address, StringFormat='Address: {0}'}" Foreground="#475569" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="ORDER METADATA" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SelectedOrder.OrderDate, StringFormat='Order Date: {0:dd/MM/yyyy}'}" Foreground="#0F172A" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SelectedOrder.ReceivingDate, StringFormat='Receiving Date: {0:dd/MM/yyyy}'}" Foreground="#0F172A" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0"/>

                                    <Border Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="12" Padding="10,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedOrder.Status}" Value="Completed">
                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedOrder.Status}" Value="Pending">
                                                        <Setter Property="Background" Value="#FFFBEB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedOrder.Status, StringFormat='Status: {0}'}" FontSize="12" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedOrder.Status}" Value="Completed">
                                                            <Setter Property="Foreground" Value="#047857"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedOrder.Status}" Value="Pending">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,0,0,16" Background="#E2E8F0"/>

                            <TextBlock Text="ORDERED ITEMS" Foreground="#0F172A" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                            <DataGrid ItemsSource="{Binding SelectedOrder.Items}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" MinHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ItemNameSnapshot}" Width="*" MinWidth="180" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="80" ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="80"/>
                                    <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat='Rs. {0:N2}'}" Width="120"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal, StringFormat='Rs. {0:N2}'}" Width="140" FontWeight="Bold" Foreground="#047857"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Background="#F1F5F9" Padding="14,10" CornerRadius="6" Margin="0,16,0,0">
                                <Grid>
                                    <TextBlock Text="GRAND TOTAL AMOUNT:" Foreground="#0F172A" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedOrder.TotalAmount, StringFormat='Rs. {0:N2}'}" Foreground="#7A0C0C" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
