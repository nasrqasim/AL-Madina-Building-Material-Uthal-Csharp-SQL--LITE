<UserControl x:Class="AlMadinaERP.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <!-- TAB 1: ACCOUNT SETTINGS -->
            <TabItem Header="🔒 Account Settings" FontSize="14" FontWeight="Bold" Padding="14,8">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Account Settings" Foreground="#0F172A" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Manage administrator account credentials, credentials security, and system access." Foreground="#64748B" FontSize="12" Margin="0,2,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Profile Card -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#FEE2E2" Margin="0,0,12,0">
                                        <TextBlock Text="A" Foreground="#7A0C0C" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Administrator" Foreground="#0F172A" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="ADMIN" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>

                                <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

                                <TextBlock Text="ADMIN NAME" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="Administrator" Foreground="#0F172A" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,12"/>

                                <TextBlock Text="EMAIL / USERNAME" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="AlMadinabuildingmaterialuthalshop@gmail.com" Foreground="#0F172A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                <TextBlock Text="Username: superadmin" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"/>

                                <TextBlock Text="ACCOUNT ROLE" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                                <Border Background="#7A0C0C" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Margin="0,4,0,12">
                                    <TextBlock Text="ADMIN" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                </Border>

                                <TextBlock Text="ACCOUNT STATUS" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                                <Border Background="#DCFCE7" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Margin="0,4,0,12">
                                    <TextBlock Text="+ ACTIVE" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                </Border>

                                <TextBlock Text="LAST PASSWORD CHANGED" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="7/31/2026, 1:25:55 AM" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Change Password Card -->
                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="24">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🔑 " FontSize="18"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Change Administrator Password" Foreground="#0F172A" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Update your login credentials securely. Your old password will no longer work once updated." Foreground="#64748B" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Current Password *" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
                                    <CheckBox Content="Show Passwords" IsChecked="{Binding IsPasswordVisible}" HorizontalAlignment="Right" FontSize="11" Foreground="#64748B"/>
                                </DockPanel>

                                <!-- Current Password -->
                                <Grid Margin="0,0,0,14">
                                    <TextBox Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </Grid>

                                <!-- New Password -->
                                <TextBlock Text="New Password *" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,14">
                                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </Grid>

                                <!-- Confirm New Password -->
                                <TextBlock Text="Confirm New Password *" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,16">
                                    <TextBox Text="{Binding ConfirmNewPassword, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </Grid>

                                <!-- Security Guidelines Box -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Security Guidelines" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Default Superadmin credentials: Superadmin / admin1234" Foreground="#64748B" FontSize="11"/>
                                        <TextBlock Text="• Use a secure password combination." Foreground="#64748B" FontSize="11"/>
                                        <TextBlock Text="• Password updates take effect immediately on next login." Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding PasswordStatusMessage}" Foreground="{Binding PasswordStatusColor}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <Button Content="🔒 UPDATE PASSWORD" Command="{Binding UpdatePasswordCommand}" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="18,10" HorizontalAlignment="Right" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- TAB 2: BACKUP & EXPORT -->
            <TabItem Header="💾 Backup &amp; Export" FontSize="14" FontWeight="Bold" Padding="14,8">
                <StackPanel Margin="0,16,0,0">
                    <Grid Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Data Management" Foreground="#0F172A" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Backup &amp; Export - Download a copy of your company's data. Keep it safe." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right">
                            <TextBlock Text="🔒 SECURE BACKUP SYSTEM" Foreground="#1D4ED8" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Backup Cards (2 Columns) -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Create Backup -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Create Backup" Foreground="#0F172A" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Full snapshot of every record in your company — items, customers, vendors, transactions, settings. Saved as a zip file." Foreground="#64748B" FontSize="11" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                <TextBlock Text="• For disaster recovery — send to support if you ever need to restore." Foreground="#64748B" FontSize="11"/>
                                <TextBlock Text="• Complete and machine-readable." Foreground="#64748B" FontSize="11"/>
                                <Button Content="💾 Create Backup" Command="{Binding CreateBackupCommand}" Background="#7A0C0C" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Export Data -->
                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Export Data" Foreground="#0F172A" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Human-readable copy of your data as a single Excel workbook. Open it directly in Excel or Google Sheets." Foreground="#64748B" FontSize="11" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                <TextBlock Text="• For browsing, auditing, or sharing with your accountant." Foreground="#64748B" FontSize="11"/>
                                <TextBlock Text="• Normalized data split into linked sheets." Foreground="#64748B" FontSize="11"/>
                                <Button Content="📊 Export Data" Command="{Binding ExportDataCommand}" Background="#070B19" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding BackupStatusMessage}" Foreground="#16A34A" FontSize="12" FontWeight="Bold" Margin="0,0,0,14"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </ScrollViewer>
</UserControl>
